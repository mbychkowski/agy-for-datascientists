{
  "ds-command-center-guardrails": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/guardrail-hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "ds-command-center-evidence-board": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/event-recorder-pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/event-recorder-post",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
