{
  "_comment": "Tile manifest: the single source of truth for every Evidence Board Tile, in demo order. Tables and chart queries may only touch staging, features or ml (board/manifest.py rejects anything else); 'tables' gate readiness, and an optional chart 'reads' lists extra working tables the chart query may read without gating readiness. Readiness is 'non_empty' (every table exists with rows) or 'chart_rows' (that, and the chart query returns at least one row; 2D uses it to land only once trials for the refresh period exist; the refresh period, 2026-W44, is named in 2D's query regex, period literal, matchers and timer label, which change together). 'proves' placeholders are filled from the chart's last row. Event matchers map recorded hook events (bin/event_recorder.py) to a Tile's activity: 'lane' (one lane per label), 'blocked' (a guardrail deny), 'approval' (a written file awaiting approval), 'timer' (started by a pre event, stopped by a failed post or a deny), 'review' (a reviewer dispatched) or 'ticker' (one entry per matching pre event, newest last); every kind but 'blocked' needs a label. 'tool' must match the whole tool name and 'summary' is searched.",
  "tiles": [
    {
      "id": "opening",
      "step": "Opening",
      "title": "The Northeast Spike",
      "tables": [
        "staging.hospital_flu"
      ],
      "readiness": {
        "rule": "non_empty"
      },
      "chart": {
        "type": "weekly_bar",
        "query": [
          "WITH weekly AS (",
          "  SELECT",
          "    DATE_ADD(DATE_TRUNC(feed_date, WEEK(SUNDAY)), INTERVAL 6 DAY) AS week_end,",
          "    SUM(positive_flu_tests) AS positive_flu_tests",
          "  FROM `staging.hospital_flu`",
          "  WHERE region = 'Northeast'",
          "    AND feed_date BETWEEN DATE '2026-09-06' AND DATE '2026-10-31'",
          "  GROUP BY week_end",
          ")",
          "SELECT",
          "  week_end,",
          "  positive_flu_tests,",
          "  ROUND(",
          "    SAFE_DIVIDE(",
          "      positive_flu_tests - LAG(positive_flu_tests) OVER (ORDER BY week_end),",
          "      LAG(positive_flu_tests) OVER (ORDER BY week_end)",
          "    ) * 100.0,",
          "    1",
          "  ) AS wow_pct",
          "FROM weekly",
          "ORDER BY week_end"
        ]
      },
      "proves": "Northeast flu-positive counts rose {wow_pct:+.0f}% in the week ending on the Cutoff, in raw counts: the Spike the agents must explain.",
      "proves_fallback": "Northeast flu-positive counts jumped in the week ending on the Cutoff, in raw counts: the Spike the agents must explain.",
      "matchers": [
        {
          "kind": "blocked",
          "tool": ".*"
        }
      ]
    },
    {
      "id": "1a",
      "step": "Segment 1A",
      "title": "Where the Spike lives",
      "tables": [
        "staging.ws1_eda_heatmap"
      ],
      "readiness": {
        "rule": "non_empty"
      },
      "chart": {
        "type": "heatmap",
        "query": [
          "WITH ne AS (",
          "  SELECT hospital_id, week_end, positive_flu_tests, positivity, share_of_ne_spike_pct",
          "  FROM `staging.ws1_eda_heatmap`",
          "  WHERE region = 'Northeast'",
          "),",
          "hospitals AS (",
          "  SELECT",
          "    hospital_id,",
          "    ANY_VALUE(share_of_ne_spike_pct) AS share,",
          "    COUNT(*) OVER () AS ne_hospitals",
          "  FROM ne",
          "  GROUP BY hospital_id",
          "),",
          "totals AS (",
          "  -- A Spike hospital carries at least half of an even share of the Spike.",
          "  SELECT",
          "    ANY_VALUE(ne_hospitals) AS ne_hospitals,",
          "    COUNTIF(share >= 50.0 / ne_hospitals) AS spike_hospitals,",
          "    ROUND(SUM(IF(share >= 50.0 / ne_hospitals, share, 0)), 1) AS spike_share_pct",
          "  FROM hospitals",
          ")",
          "SELECT",
          "  ne.hospital_id,",
          "  ne.week_end,",
          "  ne.positive_flu_tests,",
          "  ne.positivity,",
          "  ROUND(",
          "    SAFE_DIVIDE(",
          "      ne.positive_flu_tests - LAG(ne.positive_flu_tests) OVER w,",
          "      LAG(ne.positive_flu_tests) OVER w",
          "    ) * 100.0,",
          "    1",
          "  ) AS wow_pct,",
          "  ne.share_of_ne_spike_pct,",
          "  totals.ne_hospitals,",
          "  totals.spike_hospitals,",
          "  totals.ne_hospitals - totals.spike_hospitals AS other_hospitals,",
          "  totals.spike_share_pct",
          "FROM ne",
          "CROSS JOIN totals",
          "WINDOW w AS (PARTITION BY ne.hospital_id ORDER BY ne.week_end)",
          "ORDER BY ne.share_of_ne_spike_pct DESC, ne.hospital_id, ne.week_end"
        ]
      },
      "proves": "{spike_hospitals} of {ne_hospitals} Northeast hospitals carry {spike_share_pct:.0f}% of the Spike in the week ending on the Cutoff; the other {other_hospitals} share the rest.",
      "matchers": [
        {
          "kind": "lane",
          "label": "Profiling staging.hospital_flu",
          "tool": ".*",
          "summary": "\\bstaging\\.hospital_flu\\b"
        }
      ],
      "proves_fallback": "The Spike is concentrated in specific Northeast hospitals in the week ending on the Cutoff, not spread evenly across the region."
    },
    {
      "id": "1b",
      "step": "Segment 1B",
      "title": "Attribution of the Spike",
      "tables": [
        "staging.ws1_attribution"
      ],
      "readiness": {
        "rule": "non_empty"
      },
      "chart": {
        "type": "waterfall",
        "query": [
          "SELECT",
          "  cause,",
          "  contributed_points,",
          "  affected_hospitals,",
          "  evidence,",
          "  ROUND(SUM(contributed_points) OVER (), 1) AS spike_points,",
          "  ROUND(",
          "    SUM(IF(cause IN ('outbreak', 'seasonal_ramp'), contributed_points, 0)) OVER (),",
          "    1",
          "  ) AS real_points",
          "FROM `staging.ws1_attribution`",
          "ORDER BY sort_order"
        ]
      },
      "proves": "The four causes add up to the {spike_points:+.0f}% Spike; only {real_points:.0f} of those points are real disease (Outbreak plus Seasonal Ramp), the rest is the Pipeline Defect and the Sampling Artifact.",
      "matchers": [
        {
          "kind": "lane",
          "label": "distribution-triage",
          "tool": "(.*[_.])?invoke_subagent",
          "summary": "^distribution-triage\\b"
        },
        {
          "kind": "lane",
          "label": "sampling-triage",
          "tool": "(.*[_.])?invoke_subagent",
          "summary": "^sampling-triage\\b"
        },
        {
          "kind": "lane",
          "label": "pipeline-triage",
          "tool": "(.*[_.])?invoke_subagent",
          "summary": "^pipeline-triage\\b"
        },
        {
          "kind": "review",
          "label": "stats-reviewer",
          "tool": "(.*[_.])?invoke_subagent",
          "summary": "^stats-reviewer\\b"
        }
      ],
      "proves_fallback": "Four causes (Pipeline Defect, Sampling Artifact, Outbreak and Seasonal Ramp) add up to the Spike, and only the Outbreak and Seasonal Ramp are real disease."
    },
    {
      "id": "1c",
      "step": "Segment 1C",
      "title": "The Pipeline Defect removed",
      "tables": [
        "staging.hospital_flu_clean"
      ],
      "readiness": {
        "rule": "non_empty"
      },
      "chart": {
        "type": "before_after",
        "reads": [
          "staging.hospital_flu"
        ],
        "query": [
          "WITH after_keys AS (",
          "  SELECT hospital_id, feed_date, COUNT(*) AS n",
          "  FROM `staging.hospital_flu_clean`",
          "  GROUP BY hospital_id, feed_date",
          "),",
          "before_keys AS (",
          "  SELECT hospital_id, feed_date, COUNT(*) AS n",
          "  FROM `staging.hospital_flu`",
          "  GROUP BY hospital_id, feed_date",
          ")",
          "SELECT",
          "  b.before_rows,",
          "  b.before_duplicate_keys,",
          "  a.after_rows,",
          "  a.after_duplicate_keys,",
          "  b.before_rows - a.after_rows AS rows_removed",
          "FROM (",
          "  SELECT SUM(n) AS before_rows, COUNTIF(n > 1) AS before_duplicate_keys FROM before_keys",
          ") AS b",
          "CROSS JOIN (",
          "  SELECT SUM(n) AS after_rows, COUNTIF(n > 1) AS after_duplicate_keys FROM after_keys",
          ") AS a"
        ]
      },
      "proves": "Deduplicating by hospital and feed date removes {rows_removed:,} Hospital Feed rows across {before_duplicate_keys:,} duplicate keys, leaving {after_duplicate_keys:,} duplicate keys in staging.hospital_flu_clean.",
      "matchers": [
        {
          "kind": "timer",
          "label": "Dataproc Serverless batch",
          "tool": ".*",
          "summary": "gcloud\\s+(beta\\s+)?dataproc\\s+batches\\s+submit"
        },
        {
          "kind": "approval",
          "label": "pipelines/pipeline_clean.py",
          "tool": "(?i)(.*[_.])?\\w*(write|edit|replace)\\w*",
          "summary": "pipeline_clean\\.py"
        }
      ],
      "proves_fallback": "Deduplicating the Hospital Feeds by hospital and feed date removes the duplicate rows behind the Pipeline Defect."
    },
    {
      "id": "2a",
      "step": "Segment 2A",
      "title": "Hospital Cohorts",
      "tables": [
        "features.hospital_cohorts"
      ],
      "readiness": {
        "rule": "non_empty"
      },
      "chart": {
        "type": "cohorts",
        "query": [
          "WITH hospitals AS (",
          "  SELECT hospital_id, cohort_id, peak_arrival_week, seasonal_trend",
          "  FROM `features.hospital_cohorts`",
          "),",
          "cohorts AS (",
          "  SELECT cohort_id, COUNT(*) AS cohort_size, AVG(seasonal_trend) AS mean_trend",
          "  FROM hospitals",
          "  GROUP BY cohort_id",
          "),",
          "breakout AS (",
          "  -- The Outbreak Cohort: the steepest seasonal rise, found from the data.",
          "  SELECT cohort_id AS breakout_cohort, cohort_size AS breakout_size",
          "  FROM cohorts",
          "  ORDER BY mean_trend DESC, cohort_size, cohort_id",
          "  LIMIT 1",
          "),",
          "members AS (",
          "  SELECT STRING_AGG(h.hospital_id, ', ' ORDER BY h.hospital_id) AS breakout_hospitals",
          "  FROM hospitals AS h",
          "  JOIN breakout AS b ON h.cohort_id = b.breakout_cohort",
          "),",
          "totals AS (",
          "  SELECT COUNT(*) AS hospitals, COUNT(DISTINCT cohort_id) AS cohorts",
          "  FROM hospitals",
          ")",
          "SELECT",
          "  h.hospital_id,",
          "  h.cohort_id,",
          "  c.cohort_size,",
          "  h.peak_arrival_week,",
          "  ROUND(h.seasonal_trend, 3) AS seasonal_trend,",
          "  b.breakout_cohort,",
          "  b.breakout_size,",
          "  m.breakout_hospitals,",
          "  t.hospitals,",
          "  t.cohorts",
          "FROM hospitals AS h",
          "JOIN cohorts AS c ON h.cohort_id = c.cohort_id",
          "CROSS JOIN breakout AS b",
          "CROSS JOIN members AS m",
          "CROSS JOIN totals AS t",
          "ORDER BY h.cohort_id, h.hospital_id"
        ]
      },
      "proves": "K-means sorts {hospitals} hospitals into {cohorts} Cohorts by seasonal shape; the steepest-rising Cohort, {breakout_cohort}, holds just {breakout_size} hospitals ({breakout_hospitals}), isolating the Outbreak in its own Cohort.",
      "proves_fallback": "K-means sorts hospitals into Cohorts by seasonal shape, and the steepest-rising Cohort isolates the Outbreak hospitals.",
      "matchers": [
        {
          "kind": "timer",
          "label": "BQML K-means training",
          "tool": "(.*[_.])?(run_command|call_mcp_tool|execute_sql\\w*)",
          "summary": "\\[bqml: [^\\]]*\\bKMEANS\\b|(?i:\\bml\\.\\w*k_?means\\w*)"
        },
        {
          "kind": "timer",
          "label": "BQML K-means training",
          "tool": "(.*[_.])?run_command",
          "summary": "(?i)\\bbq\\s.*\\bsql/\\S*k_?means\\S*\\.sql\\b|\\bsql/\\S*k_?means\\S*\\.sql\\b.*\\|\\s*bq\\s"
        }
      ]
    },
    {
      "id": "2b",
      "step": "Segment 2B",
      "title": "WAPE leaderboard",
      "tables": [
        "ml.forecast_leaderboard"
      ],
      "readiness": {
        "rule": "non_empty"
      },
      "chart": {
        "type": "leaderboard",
        "query": [
          "WITH cells AS (",
          "  -- One cell per Cohort, family and training data, averaged over periods.",
          "  SELECT",
          "    cohort_id,",
          "    model_family,",
          "    training_data_version,",
          "    ROUND(AVG(backtest_wape), 2) AS backtest_wape",
          "  FROM `ml.forecast_leaderboard`",
          "  GROUP BY cohort_id, model_family, training_data_version",
          "),",
          "versions AS (",
          "  SELECT",
          "    ROUND(AVG(IF(training_data_version = 'clean', backtest_wape, NULL)), 2) AS clean_wape,",
          "    ROUND(AVG(IF(training_data_version = 'uncleaned', backtest_wape, NULL)), 2) AS uncleaned_wape",
          "  FROM cells",
          "),",
          "pairs AS (",
          "  SELECT",
          "    COUNTIF(c.backtest_wape < u.backtest_wape) AS clean_wins,",
          "    COUNT(*) AS comparisons",
          "  FROM cells AS c",
          "  JOIN cells AS u",
          "    ON c.cohort_id = u.cohort_id AND c.model_family = u.model_family",
          "  WHERE c.training_data_version = 'clean' AND u.training_data_version = 'uncleaned'",
          "),",
          "best AS (",
          "  SELECT model_family AS best_family",
          "  FROM cells",
          "  WHERE training_data_version = 'clean'",
          "  GROUP BY model_family",
          "  ORDER BY AVG(backtest_wape), model_family",
          "  LIMIT 1",
          ")",
          "SELECT",
          "  cells.cohort_id,",
          "  cells.model_family,",
          "  cells.training_data_version,",
          "  cells.backtest_wape,",
          "  versions.clean_wape,",
          "  versions.uncleaned_wape,",
          "  pairs.clean_wins,",
          "  pairs.comparisons,",
          "  best.best_family",
          "FROM cells",
          "CROSS JOIN versions",
          "CROSS JOIN pairs",
          "LEFT JOIN best ON TRUE",
          "ORDER BY cells.cohort_id, cells.model_family, cells.training_data_version"
        ]
      },
      "proves": "Forecasts trained on clean data beat uncleaned data in {clean_wins} of {comparisons} Cohort and model pairs, with mean WAPE {clean_wape:.1f}% vs {uncleaned_wape:.1f}%; {best_family} leads on clean data.",
      "proves_fallback": "Forecasts trained on clean data beat forecasts trained on uncleaned data on WAPE, for both ARIMA_PLUS and TimesFM.",
      "matchers": [
        {
          "kind": "ticker",
          "label": "ARIMA_PLUS",
          "tool": "(.*[_.])?(run_command|call_mcp_tool|execute_sql\\w*)",
          "summary": "\\[bqml: [^\\]]*\\bARIMA_PLUS\\b|(?i:\\bml\\.\\w*arima\\w*)"
        },
        {
          "kind": "ticker",
          "label": "TimesFM",
          "tool": "(.*[_.])?(run_command|call_mcp_tool|execute_sql\\w*)",
          "summary": "\\[bqml: [^\\]]*\\bAI\\.FORECAST\\b|(?i:timesfm)"
        },
        {
          "kind": "ticker",
          "label": "ARIMA_PLUS + TimesFM",
          "tool": "(.*[_.])?run_command",
          "summary": "(?i)\\bbq\\s.*\\bsql/\\S*(forecast|arima|trial)\\S*\\.sql\\b|\\bsql/\\S*(forecast|arima|trial)\\S*\\.sql\\b.*\\|\\s*bq\\s"
        },
        {
          "kind": "ticker",
          "label": "Trial logged",
          "tool": "(.*[_.])?(run_command|call_mcp_tool|execute_sql\\w*)",
          "summary": "^(?!.*\\bml\\.forecast_leaderboard\\b).*\\bml\\.experiment_trials\\b"
        }
      ]
    },
    {
      "id": "2c",
      "step": "Segment 2C",
      "title": "The Reveal",
      "tables": [
        "staging.reveal_forecast_comparison"
      ],
      "readiness": {
        "rule": "non_empty"
      },
      "chart": {
        "type": "reveal",
        "query": [
          "WITH weeks AS (",
          "  -- One row per Reveal week: reality against both forecasts.",
          "  SELECT",
          "    horizon_week,",
          "    week_start,",
          "    week_end,",
          "    reveal_observed_positives,",
          "    clean_forecast_positives,",
          "    uncleaned_forecast_positives",
          "  FROM `staging.reveal_forecast_comparison`",
          "),",
          "totals AS (",
          "  SELECT",
          "    COUNT(*) AS reveal_weeks,",
          "    ROUND(100 * SAFE_DIVIDE(SUM(ABS(clean_forecast_positives - reveal_observed_positives)), SUM(reveal_observed_positives)), 1) AS clean_wape,",
          "    ROUND(100 * SAFE_DIVIDE(SUM(ABS(uncleaned_forecast_positives - reveal_observed_positives)), SUM(reveal_observed_positives)), 1) AS uncleaned_wape",
          "  FROM weeks",
          ")",
          "SELECT",
          "  weeks.horizon_week,",
          "  weeks.week_start,",
          "  weeks.week_end,",
          "  weeks.reveal_observed_positives,",
          "  weeks.clean_forecast_positives,",
          "  weeks.uncleaned_forecast_positives,",
          "  totals.reveal_weeks,",
          "  totals.clean_wape,",
          "  totals.uncleaned_wape",
          "FROM weeks",
          "CROSS JOIN totals",
          "ORDER BY weeks.week_start"
        ]
      },
      "proves": "Over the {reveal_weeks} Reveal weeks after the Cutoff, the clean-data forecast tracks reality at {clean_wape:.1f}% WAPE, against {uncleaned_wape:.1f}% for the uncleaned forecast.",
      "proves_fallback": "Over the six Reveal weeks after the Cutoff, the clean-data forecast tracks reality while the uncleaned forecast overshoots.",
      "matchers": [
        {
          "kind": "timer",
          "label": "Loading the Reveal",
          "tool": "(.*[_.])?(run_command|call_mcp_tool|execute_sql\\w*)",
          "summary": "(?i)\\bload-reveal\\b|\\bws2_reveal_comparison\\b|\\bstaging\\.reveal_forecast_comparison\\b"
        }
      ]
    },
    {
      "id": "2d",
      "step": "Segment 2D",
      "title": "Next-period refresh",
      "tables": [
        "ml.experiment_trials",
        "ml.forecast_leaderboard"
      ],
      "readiness": {
        "rule": "chart_rows"
      },
      "chart": {
        "type": "refresh",
        "query": [
          "WITH refresh AS (",
          "  -- Trials the cohort-forecast-refresh skill logged for the refresh",
          "  -- period, 2026-W44: its trial ids, data versions and parameters name it.",
          "  SELECT cohort_id, model_family, backtest_wape",
          "  FROM `ml.experiment_trials`",
          "  WHERE REGEXP_CONTAINS(",
          "    LOWER(CONCAT(",
          "      IFNULL(trial_id, ''), ' ',",
          "      IFNULL(training_data_version, ''), ' ',",
          "      IFNULL(TO_JSON_STRING(parameters), '')",
          "    )),",
          "    r'2026[-_]?w44'",
          "  )",
          "),",
          "cells AS (",
          "  SELECT cohort_id, model_family, ROUND(AVG(backtest_wape), 4) AS backtest_wape",
          "  FROM refresh",
          "  GROUP BY cohort_id, model_family",
          "),",
          "totals AS (",
          "  SELECT COUNT(*) AS new_trials, COUNT(DISTINCT cohort_id) AS cohorts",
          "  FROM refresh",
          "),",
          "best AS (",
          "  SELECT model_family AS best_family",
          "  FROM cells",
          "  GROUP BY model_family",
          "  ORDER BY AVG(backtest_wape), model_family",
          "  LIMIT 1",
          ")",
          "SELECT",
          "  '2026-W44' AS period,",
          "  cells.cohort_id,",
          "  cells.model_family,",
          "  cells.backtest_wape,",
          "  totals.new_trials,",
          "  totals.cohorts,",
          "  best.best_family",
          "FROM cells",
          "CROSS JOIN totals",
          "LEFT JOIN best ON TRUE",
          "ORDER BY cells.cohort_id, cells.model_family"
        ]
      },
      "proves": "The cohort-forecast-refresh skill reran the forecasting workflow for {period}: {new_trials} new trials across {cohorts} Cohorts, with {best_family} leading on backtest WAPE.",
      "proves_fallback": "The team skill reruns the whole forecasting workflow for the next epidemiological period.",
      "matchers": [
        {
          "kind": "lane",
          "label": "SKILL.md written",
          "tool": "(?i)(.*[_.])?\\w*(write|edit|replace)\\w*",
          "summary": "cohort-forecast-refresh/SKILL\\.md"
        },
        {
          "kind": "lane",
          "label": "Fresh subagent dispatched",
          "tool": "(.*[_.])?invoke_subagent",
          "summary": "(?i)refresh|next.?period|2026.?w44|cohort.?forecast"
        },
        {
          "kind": "timer",
          "label": "Refreshing 2026-W44",
          "tool": "(.*[_.])?run_command",
          "summary": "(?i)run-cohort-forecast-refresh|cohort_forecast_refresh"
        }
      ]
    }
  ]
}
