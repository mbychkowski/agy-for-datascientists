#!/usr/bin/env bash
# ==============================================================================
# Antigravity Command Center PreToolUse Guardrail Hook (ds-command-center)
#
# Enforces repository and dataset boundary constraints before tool execution:
#   1. Blocks direct `git push origin main` (requires feature-branch PR flow).
#   2. Blocks `--service-account` on `gcloud dataproc batches submit` (ADR 0002).
#   3. Blocks invalid `spark.dataproc.ShieldedVm.*` properties on Dataproc Serverless.
#   4. Blocks all agent access (read or write, SQL or CLI or MCP) to `checkpoint`.
#   5. Blocks DML/DDL and mutating CLI commands against read-only `raw` and `ops`.
#
# The Dataproc checks (2-3 above) skip lines that only carry prose: text-only
# commands, with git and gh limited to PROSE_SUBCOMMANDS (commit, tag, issue,
# pr, ...), so commit messages and issue bodies can name the blocked flags. A
# real submit, chained or behind bash -c, is still denied.
#
# The checkpoint and raw/ops checks (4-5 above, step 3 in check_shell_command)
# run on every shell command except text-only ones: every command is on
# TEXT_ONLY_COMMANDS (git, gh, echo, cat, ...) and nothing in the line can reach
# BigQuery. This lets prose in commit messages, gh bodies, and heredocs into
# files name the `checkpoint` dataset without being read as SQL.
# ==============================================================================

set -uo pipefail

# Resolve real script directory through any symlinks (CODING_STANDARDS.md §1)
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "${SOURCE}" ]]; do
    DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
PLUGIN_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
REPO_ROOT="$(cd "${PLUGIN_DIR}/../../.." && pwd)"
export PLUGIN_DIR REPO_ROOT

payload="$(cat)"

python3 -c '
import json
import re
import shlex
import sys

CHECKPOINT_DENY_REASON = (
    "Access to the checkpoint dataset is blocked for agents "
    "(Checkpoint tables are reserved for presenter Checkpoint swaps outside the agent). "
    "Proceed read-only by querying raw and ops with SELECT "
    "(or reading working tables in staging, features, and ml)."
)

RAW_OPS_DENY_REASON = (
    "DML/DDL against raw or ops is blocked because raw and ops are strictly read-only source datasets. "
    "Proceed read-only by running SELECT queries against raw and ops, "
    "and write any derived tables or models to staging, features, or ml."
)


def allow():
    print(json.dumps({"decision": "allow"}))
    sys.exit(0)


def deny(reason: str):
    print(json.dumps({"decision": "deny", "reason": reason}))
    sys.exit(0)


def parse_dict_maybe(val):
    if isinstance(val, dict):
        return val
    if isinstance(val, str):
        s = val.strip()
        if s.startswith("{") and s.endswith("}"):
            try:
                parsed = json.loads(s)
                if isinstance(parsed, dict):
                    return parsed
            except Exception:
                pass
    return {}


def extract_invocations(data):
    if not isinstance(data, dict):
        return []

    for wrapper_key in ("preToolHookArgs", "toolHookArgs", "hookArgs"):
        if isinstance(data.get(wrapper_key), dict):
            data = data[wrapper_key]
            break

    tc = data.get("toolCall") or data.get("tool_call")
    if isinstance(tc, dict):
        name = tc.get("name") or tc.get("toolName") or tc.get("tool_name") or ""
        args = (
            tc.get("args")
            if "args" in tc
            else tc.get("arguments")
            if "arguments" in tc
            else tc.get("tool_input")
            if "tool_input" in tc
            else tc.get("toolArgs")
            if "toolArgs" in tc
            else tc.get("parameters")
            if "parameters" in tc
            else tc.get("input", {})
        )
    else:
        name = data.get("tool_name") or data.get("toolName") or data.get("name") or ""
        args = (
            data.get("tool_input")
            if "tool_input" in data
            else data.get("toolArgs")
            if "toolArgs" in data
            else data.get("args")
            if "args" in data
            else data.get("arguments")
            if "arguments" in data
            else data.get("parameters")
            if "parameters" in data
            else data.get("input", {})
        )

    args_dict = parse_dict_maybe(args)
    invocations = [(str(name), args_dict)]

    if str(name) == "call_mcp_tool" or str(name).endswith("call_mcp_tool"):
        inner_name = (
            args_dict.get("ToolName")
            or args_dict.get("tool_name")
            or args_dict.get("toolName")
            or args_dict.get("name")
            or ""
        )
        inner_args = (
            args_dict.get("Arguments")
            if "Arguments" in args_dict
            else args_dict.get("arguments")
            if "arguments" in args_dict
            else args_dict.get("args")
            if "args" in args_dict
            else args_dict.get("tool_input", {})
        )
        invocations.append((str(inner_name), parse_dict_maybe(inner_args)))

    return invocations


def normalize_sql(sql: str, is_shell_cmd: bool = False) -> str:
    s = re.sub(r"/\*.*?\*/", " ", sql, flags=re.DOTALL)
    if is_shell_cmd:
        s = re.sub(r"--(?![a-zA-Z0-9_-]+=)[^\r\n]*", " ", s)
    else:
        s = re.sub(r"--[^\r\n]*", " ", s)
    s = s.replace("\\`", "").replace("`", "").replace("[", " ").replace("]", " ")
    return s


PROJ_PREFIX = r"(?:[A-Za-z0-9_${}-]+[:.])?"

CHECKPOINT_SQL_RE = re.compile(
    rf"(?:(?<![A-Za-z0-9_${{}}-]){PROJ_PREFIX}checkpoint\s*\.\s*"
    r"(?!(?:py|sh|md|json|yaml|yml|txt|csv|sql|js|ts|env|lock|toml)\b)[A-Za-z0-9_${}*]+)"
    rf"|(?:\b(?:SCHEMA|DATABASE)\s+(?:IF\s+(?:NOT\s+)?EXISTS\s+)?{PROJ_PREFIX}checkpoint\b)",
    re.IGNORECASE,
)

TARGET_RAW_OPS = rf"{PROJ_PREFIX}(?:raw|ops)\s*\.\s*[A-Za-z0-9_${{}}]+"
SCHEMA_RAW_OPS = rf"{PROJ_PREFIX}(?:raw|ops)\b"

RAW_OPS_MUTATION_RE = re.compile(
    "|".join(
        [
            rf"\bINSERT\s+(?:(?:OR\s+IGNORE|OR\s+REPLACE)\s+)?(?:INTO\s+)?{TARGET_RAW_OPS}",
            rf"\bUPDATE\s+{TARGET_RAW_OPS}",
            rf"\bDELETE\s+(?:FROM\s+)?{TARGET_RAW_OPS}",
            rf"\bMERGE\s+(?:INTO\s+)?{TARGET_RAW_OPS}",
            rf"\bTRUNCATE\s+(?:TABLE\s+)?{TARGET_RAW_OPS}",
            rf"\bCREATE\s+(?:OR\s+REPLACE\s+)?(?:TEMP(?:ORARY)?\s+)?(?:(?:EXTERNAL|MATERIALIZED|SNAPSHOT)\s+)?"
            rf"(?:TABLE(?:\s+(?:SNAPSHOT|CLONE))?|VIEW|MODEL|(?:(?:AGGREGATE|TABLE)\s+)?FUNCTION|PROCEDURE)\s+"
            rf"(?:IF\s+NOT\s+EXISTS\s+)?{TARGET_RAW_OPS}",
            rf"\bALTER\s+(?:MATERIALIZED\s+)?(?:TABLE|VIEW|MODEL|PROCEDURE|FUNCTION)\s+(?:IF\s+EXISTS\s+)?{TARGET_RAW_OPS}",
            rf"\bDROP\s+(?:(?:EXTERNAL|MATERIALIZED|SNAPSHOT)\s+)?"
            rf"(?:TABLE(?:\s+SNAPSHOT)?|VIEW|MODEL|(?:TABLE\s+)?FUNCTION|PROCEDURE)\s+"
            rf"(?:IF\s+EXISTS\s+)?{TARGET_RAW_OPS}",
            rf"\bUNDROP\s+TABLE\s+(?:IF\s+NOT\s+EXISTS\s+)?{TARGET_RAW_OPS}",
            rf"\b(?:CREATE(?:\s+OR\s+REPLACE)?|ALTER|DROP|UNDROP)\s+(?:SCHEMA|DATABASE)\s+"
            rf"(?:IF\s+(?:NOT\s+)?EXISTS\s+)?{SCHEMA_RAW_OPS}",
            rf"\bLOAD\s+DATA\s+(?:INTO|OVERWRITE)\s+(?:TABLE\s+)?{TARGET_RAW_OPS}",
            rf"\b(?:GRANT|REVOKE)\b[^;]*?\bON\s+(?:(?:TABLE|VIEW|SCHEMA|EXTERNAL\s+TABLE)\s+)?(?:{TARGET_RAW_OPS}|{SCHEMA_RAW_OPS})",
        ]
    ),
    re.IGNORECASE | re.DOTALL,
)

UNQUALIFIED_MUTATION_RE = re.compile(
    r"\b(?:INSERT\s+(?:(?:OR\s+IGNORE|OR\s+REPLACE)\s+)?(?:INTO\s+)?"
    r"|UPDATE\s+"
    r"|DELETE\s+(?:FROM\s+)?"
    r"|MERGE\s+(?:INTO\s+)?"
    r"|TRUNCATE\s+(?:TABLE\s+)?"
    r"|CREATE\s+(?:OR\s+REPLACE\s+)?(?:TEMP(?:ORARY)?\s+)?(?:(?:EXTERNAL|MATERIALIZED|SNAPSHOT)\s+)?"
    r"(?:TABLE(?:\s+(?:SNAPSHOT|CLONE))?|VIEW|MODEL|(?:(?:AGGREGATE|TABLE)\s+)?FUNCTION|PROCEDURE)\s+(?:IF\s+NOT\s+EXISTS\s+)?"
    r"|ALTER\s+(?:MATERIALIZED\s+)?(?:TABLE|VIEW|MODEL|PROCEDURE|FUNCTION)\s+(?:IF\s+EXISTS\s+)?"
    r"|DROP\s+(?:(?:EXTERNAL|MATERIALIZED|SNAPSHOT)\s+)?(?:TABLE(?:\s+SNAPSHOT)?|VIEW|MODEL|(?:TABLE\s+)?FUNCTION|PROCEDURE)\s+(?:IF\s+EXISTS\s+)?"
    r"|UNDROP\s+TABLE\s+(?:IF\s+NOT\s+EXISTS\s+)?"
    r"|LOAD\s+DATA\s+(?:INTO|OVERWRITE)\s+(?:TABLE\s+)?)"
    r"([A-Za-z0-9_${}]+)(?!\s*\.)",
    re.IGNORECASE,
)


def sql_touches_checkpoint(sql: str, is_shell_cmd: bool = False) -> bool:
    cleaned = normalize_sql(sql, is_shell_cmd=is_shell_cmd)
    return bool(CHECKPOINT_SQL_RE.search(cleaned))


def sql_mutates_raw_or_ops(sql: str, default_dataset: str = "", is_shell_cmd: bool = False) -> bool:
    cleaned = normalize_sql(sql, is_shell_cmd=is_shell_cmd)
    if RAW_OPS_MUTATION_RE.search(cleaned):
        return True
    ds = default_dataset.strip().strip("\"\x27`[]").lower().split(":")[-1].split(".")[-1]
    if ds in ("raw", "ops") and UNQUALIFIED_MUTATION_RE.search(cleaned):
        return True
    return False


def arg_targets_dataset(arg: str, datasets: tuple[str, ...]) -> bool:
    val = arg.strip().strip("\"\x27`[]")
    if val.startswith("--dataset_id=") or val.startswith("--dataset="):
        val = val.split("=", 1)[1].strip().strip("\"\x27`[]")
    elif val.startswith("-"):
        return False
    ds_group = "|".join(re.escape(d) for d in datasets)
    pattern = rf"^(?:[A-Za-z0-9_${{}}-]+[:.])?(?:{ds_group})(?:[.:][A-Za-z0-9_${{}}-]+)?$"
    return bool(re.match(pattern, val, re.IGNORECASE))


BQ_SUBCOMMANDS = {
    "query",
    "show",
    "ls",
    "head",
    "rm",
    "mk",
    "load",
    "cp",
    "extract",
    "update",
    "insert",
    "truncate",
    "partition",
    "mkdef",
    "shell",
}

BQ_MUTATING_SUBCOMMANDS = {"rm", "mk", "load", "update", "insert", "truncate", "partition"}
BQ_VALUE_FLAGS = {"--project_id", "--project", "--location", "--dataset_id", "--dataset", "--format", "--job_id"}


def check_bq_segment(segment: str, fallback_ds: str = ""):
    try:
        tokens = shlex.split(segment, posix=True)
    except Exception:
        tokens = segment.split()

    bq_idx = -1
    for idx, tok in enumerate(tokens):
        base = tok.rsplit("/", 1)[-1]
        if base == "bq":
            bq_idx = idx
            break
    if bq_idx == -1:
        return

    rest = tokens[bq_idx + 1 :]
    default_ds = fallback_ds
    subcommand = ""
    sub_idx = -1

    i = 0
    while i < len(rest):
        tok = rest[i]
        if tok in ("--dataset_id", "--dataset") and i + 1 < len(rest):
            default_ds = rest[i + 1]
            i += 2
            continue
        if tok.startswith("--dataset_id=") or tok.startswith("--dataset="):
            default_ds = tok.split("=", 1)[1]
        if not subcommand and tok.lower() in BQ_SUBCOMMANDS:
            subcommand = tok.lower()
            sub_idx = i
        i += 1

    if default_ds and arg_targets_dataset(default_ds, ("checkpoint",)):
        deny(CHECKPOINT_DENY_REASON)

    for tok in rest:
        if arg_targets_dataset(tok, ("checkpoint",)):
            deny(CHECKPOINT_DENY_REASON)
        if not tok.startswith("-"):
            if sql_touches_checkpoint(tok, is_shell_cmd=False):
                deny(CHECKPOINT_DENY_REASON)
            if sql_mutates_raw_or_ops(tok, default_dataset=default_ds, is_shell_cmd=False):
                deny(RAW_OPS_DENY_REASON)

    if sql_touches_checkpoint(segment, is_shell_cmd=True):
        deny(CHECKPOINT_DENY_REASON)

    if sql_mutates_raw_or_ops(segment, default_dataset=default_ds, is_shell_cmd=True):
        deny(RAW_OPS_DENY_REASON)

    if subcommand in BQ_MUTATING_SUBCOMMANDS:
        if default_ds and arg_targets_dataset(default_ds, ("raw", "ops")):
            deny(RAW_OPS_DENY_REASON)
        for tok in rest[sub_idx + 1 :]:
            if arg_targets_dataset(tok, ("raw", "ops")):
                deny(RAW_OPS_DENY_REASON)

    if subcommand == "cp" and sub_idx != -1:
        pos_args = []
        j = sub_idx + 1
        while j < len(rest):
            tok = rest[j]
            if tok in BQ_VALUE_FLAGS:
                j += 2
                continue
            if tok.startswith("-"):
                j += 1
                continue
            pos_args.append(tok)
            j += 1
        if pos_args:
            dest = pos_args[-1]
            if arg_targets_dataset(dest, ("raw", "ops")):
                deny(RAW_OPS_DENY_REASON)
            if (
                default_ds
                and arg_targets_dataset(default_ds, ("raw", "ops"))
                and "." not in dest
                and ":" not in dest
            ):
                deny(RAW_OPS_DENY_REASON)


# Commands that only handle text (messages, file contents, listings) and never
# send SQL to BigQuery. No shells, interpreters, make, env, or ssh.
TEXT_ONLY_COMMANDS = {
    "git", "gh", "cd", "echo", "printf", "cat", "ls", "grep", "head", "tail", "wc", "diff", "mkdir", "touch",
}
BIGQUERY_WORD_RE = re.compile(r"\b(?:bq|gcloud|bigquery)\b", re.IGNORECASE)
# Substitution and eval-like words, plus git hook paths a same-line write could make git run.
INDIRECTION_RE = re.compile(r"\$\(|`|<\(|>\(|\b(?:eval|source|exec|xargs)\b|\.husky|\.git/hooks|hooksPath")
# git and gh arguments that make the allowlisted command run a shell command.
SHELL_RUNNING_ARGS = {
    "git": {"-c", "--config-env", "--exec-path", "-x", "--exec", "bisect", "submodule", "filter-branch"},
    "gh": {"alias", "extension"},
}
# The only git and gh subcommands whose text the Dataproc checks skip. git and gh
# have many more options that run a command, so this list names what is allowed.
PROSE_SUBCOMMANDS = {
    "git": {"add", "commit", "tag"},
    "gh": {"issue", "pr"},
}
HEREDOC_RE = re.compile(r"<<(-?)[ \t]*(?:\x27([^\x27\n]+)\x27|\"([^\"\n]+)\"|\\?([A-Za-z0-9_.-]+))")


def split_shell_commands(cmd: str):
    """Split cmd on unquoted ; && || | & and newlines, dropping heredoc bodies.

    Returns None when a quote is unterminated, a heredoc cannot be parsed, an
    unquoted # starts a comment (a comment can hide text from this splitter), or
    an ANSI-C $'...' string appears (bash reads its backslash escapes, this does not).
    """
    parts: list = []
    buf: list = []
    pending: list = []
    quote = ""
    word_start = True
    i, n = 0, len(cmd)
    while i < n:
        c = cmd[i]
        if quote:
            if c == "\\" and quote == "\"":
                buf.append(cmd[i : i + 2])
                i += 2
                continue
            if c == quote:
                quote = ""
            buf.append(c)
            i += 1
            continue
        if c in (" ", "\t"):
            word_start = True
            buf.append(c)
            i += 1
            continue
        if c == "#" and word_start:
            return None
        word_start = False
        if c in ("\x27", "\""):
            if c == "\x27" and cmd[i - 1 : i] == "$":
                return None
            quote = c
        elif c == "\\":
            buf.append(cmd[i : i + 2])
            i += 2
            continue
        elif cmd.startswith("<<<", i):
            buf.append("<<<")
            i += 3
            continue
        elif cmd.startswith("<<", i):
            m = HEREDOC_RE.match(cmd, i)
            if not m:
                return None
            delim = next(g for g in m.groups()[1:] if g is not None)
            pending.append((m.group(1) == "-", delim))
            buf.append(m.group(0))
            i = m.end()
            continue
        elif c == "&" and (cmd[i - 1 : i] in (">", "<") or cmd.startswith("&>", i)):
            buf.append(c)
            i += 1
            continue
        elif c in (";", "&", "|", "\n"):
            parts.append("".join(buf))
            buf.clear()
            word_start = True
            i += 1
            if c == "\n" and pending:
                for strip_tabs, delim in pending:
                    while True:
                        if i >= n:
                            return None
                        nl = cmd.find("\n", i)
                        end = n if nl == -1 else nl
                        line = cmd[i:end]
                        i = end + 1
                        if (line.lstrip("\t") if strip_tabs else line).rstrip("\r") == delim:
                            break
                pending.clear()
            continue
        buf.append(c)
        i += 1
    if quote or pending:
        return None
    parts.append("".join(buf))
    return parts


def text_command_words(cmd: str):
    """Return the words of each command in the line when all of them only handle text.

    Every command must start with a TEXT_ONLY_COMMANDS word, with no substitution,
    eval, source, exec, xargs, git hook path, or git/gh option that runs a shell
    command, even with the name split by quotes or backslashes. Words inside quoted
    strings and heredoc bodies are prose, not commands.
    Returns None otherwise, or when the line fails to parse.
    """
    if INDIRECTION_RE.search(cmd) or INDIRECTION_RE.search(re.sub(r"[\"\x27\\\\]", "", cmd)):
        return None
    parts = split_shell_commands(cmd)
    if parts is None:
        return None
    commands = []
    for part in parts:
        try:
            words = shlex.split(part, posix=True)
        except ValueError:
            return None
        if not words:
            continue
        if words[0] not in TEXT_ONLY_COMMANDS:
            return None
        if words[0] in SHELL_RUNNING_ARGS and SHELL_RUNNING_ARGS[words[0]].intersection(words[1:]):
            return None
        commands.append(words)
    return commands


def is_text_only_command(cmd: str) -> bool:
    """True when the checkpoint and raw/ops text checks can be skipped.

    Every command must pass text_command_words, and nothing in the line (heredoc
    bodies and quoted strings included) may name bq, gcloud, or bigquery, even
    split by quotes or backslashes. Anything else keeps the strict check.
    """
    unquoted = re.sub(r"[\"\x27\\\\]", "", cmd)
    if BIGQUERY_WORD_RE.search(unquoted):
        return False
    return text_command_words(cmd) is not None


def is_prose_only_command(cmd: str) -> bool:
    """True when the Dataproc flag checks can be skipped.

    Every command must pass text_command_words, and each git or gh command must
    use a PROSE_SUBCOMMANDS subcommand right after the command word (commit
    messages, tags, issue and PR bodies). The line may name gcloud, so this
    stricter allowlist stands in for the word check in is_text_only_command.
    """
    commands = text_command_words(cmd)
    if commands is None:
        return False
    return all(
        words[0] not in PROSE_SUBCOMMANDS or (len(words) > 1 and words[1] in PROSE_SUBCOMMANDS[words[0]])
        for words in commands
    )


def check_shell_command(cmd: str):
    if not cmd or not cmd.strip():
        return

    # The text-only and prose-only parsers get the raw line: bash does not join
    # backslash-newline inside a quoted heredoc body, so collapsing first could
    # hide a heredoc terminator and make a real command look like body text.
    raw_cmd = cmd

    # Collapse backslash-newline line continuations before inspecting commands
    cmd = re.sub(r"\\\r?\n", " ", cmd)

    # 1. Block direct git push to main
    if re.search(r"\bgit\b[^\n;|&]*\bpush\b[^\n;|&]*\borigin\s+main(\s|$|;|&|\|)", cmd):
        deny(
            "Direct push to main is blocked (GH006). "
            "Push a feature branch from .worktree/issue-XXX and open a PR with gh pr create."
        )

    # 2. Block ADR 0002 --service-account or invalid ShieldedVm properties on Dataproc Serverless batches.
    # Skipped when the line only carries prose, so commit messages and issue bodies can name the flags.
    if "dataproc batches submit" in cmd and not is_prose_only_command(raw_cmd):
        if "--service-account" in cmd:
            deny(
                "ADR 0002 violation: Dataproc Serverless batches must run as the presenter identity "
                "without --service-account."
            )
        if "spark.dataproc.ShieldedVm" in cmd:
            deny(
                "Dataproc Serverless for Spark uses Shielded VMs natively and rejects "
                "spark.dataproc.ShieldedVm.* properties."
            )

    # 3. Inspect bq CLI commands and embedded SQL, unless the command is text-only
    if is_text_only_command(raw_cmd):
        return
    if re.search(r"\bbq\b", cmd):
        cmd_ds_list = re.findall(
            r"--dataset(?:_id)?(?:\s*=\s*|\s+)[\"\x27]?([A-Za-z0-9_${}.:-]+)",
            cmd,
        )
        fallback_ds = ""
        for ds_candidate in cmd_ds_list:
            if arg_targets_dataset(ds_candidate, ("checkpoint",)):
                deny(CHECKPOINT_DENY_REASON)
            if arg_targets_dataset(ds_candidate, ("raw", "ops")):
                fallback_ds = ds_candidate

        segments = re.split(r"(?:&&|\|\||[;|\n])+", cmd)
        for seg in segments:
            if re.search(r"\bbq\b", seg):
                check_bq_segment(seg, fallback_ds=fallback_ds)
        if sql_touches_checkpoint(cmd, is_shell_cmd=True):
            deny(CHECKPOINT_DENY_REASON)
        if sql_mutates_raw_or_ops(cmd, default_dataset=fallback_ds, is_shell_cmd=True):
            deny(RAW_OPS_DENY_REASON)
    elif re.search(
        r"\b(?:SELECT|FROM|JOIN|INSERT|UPDATE|DELETE|MERGE|CREATE|DROP|ALTER|TRUNCATE)\b",
        cmd,
        re.IGNORECASE,
    ):
        if sql_touches_checkpoint(cmd, is_shell_cmd=True):
            deny(CHECKPOINT_DENY_REASON)
        if sql_mutates_raw_or_ops(cmd, is_shell_cmd=True):
            deny(RAW_OPS_DENY_REASON)


def check_mcp_invocation(tool_name: str, args_dict: dict):
    if not isinstance(args_dict, dict):
        return

    default_ds = ""
    for ds_key in ("dataset_id", "datasetId", "dataset"):
        val = args_dict.get(ds_key)
        if isinstance(val, str) and val.strip():
            default_ds = val.strip()
            if arg_targets_dataset(default_ds, ("checkpoint",)):
                deny(CHECKPOINT_DENY_REASON)

    for tbl_key in ("table_id", "tableId", "table"):
        val = args_dict.get(tbl_key)
        if isinstance(val, str) and val.strip():
            if arg_targets_dataset(val.strip(), ("checkpoint",)):
                deny(CHECKPOINT_DENY_REASON)

    for sql_key in ("sql", "query", "statement", "q"):
        val = args_dict.get(sql_key)
        if isinstance(val, str) and val.strip():
            if sql_touches_checkpoint(val, is_shell_cmd=False):
                deny(CHECKPOINT_DENY_REASON)
            if sql_mutates_raw_or_ops(val, default_dataset=default_ds, is_shell_cmd=False):
                deny(RAW_OPS_DENY_REASON)


raw = sys.stdin.read().strip()
if not raw:
    allow()

try:
    data = json.loads(raw)
except Exception:
    allow()

for tool_name, args_dict in extract_invocations(data):
    cmd = (
        args_dict.get("CommandLine")
        or args_dict.get("command")
        or args_dict.get("cmd")
        or ""
    )
    if isinstance(cmd, str) and cmd:
        check_shell_command(cmd)
    check_mcp_invocation(tool_name, args_dict)

allow()
' <<< "${payload}"
