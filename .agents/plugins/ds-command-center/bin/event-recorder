#!/usr/bin/env bash
# ==============================================================================
# Evidence Board event recorder hook (ds-command-center)
#
# Observe-only. Appends one redacted JSON line for the tool call to the
# workspace event log (.evidence-board/events.jsonl) via event_recorder.py, and
# always answers with exit 0, even if recording fails. The guardrail hook stays
# the only hook that can deny.
#
# hooks.json runs it through two symlinks, so each hook command needs no args:
#   event-recorder-pre   PreToolUse   answers {"decision":"allow"}
#   event-recorder-post  PostToolUse  answers {}
# ==============================================================================

set -uo pipefail

# The phase is the suffix of the name this was invoked as (before resolving it).
INVOKED_AS="$(basename "${BASH_SOURCE[0]}")"
case "${INVOKED_AS##*-}" in
    post) PHASE=post RESPONSE='{}' ;;
    *) PHASE=pre RESPONSE='{"decision":"allow"}' ;;
esac

# Resolve real script directory through any symlinks (CODING_STANDARDS.md §1)
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "${SOURCE}" ]]; do
    DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"

# The response is fixed, so a recorder failure can never change the tool call.
python3 "${SCRIPT_DIR}/event_recorder.py" "${PHASE}" >/dev/null 2>&1
echo "${RESPONSE}"
exit 0
