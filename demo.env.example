# ==============================================================================
# Antigravity for Data Scientists Demo Environment
#
# Copy this file to demo.env and configure for your Google Cloud project:
#   cp demo.env.example demo.env
#
# Do NOT commit demo.env to version control.
# ==============================================================================

# Core configuration (set these to your own GCP project and bucket names)
PROJECT_ID="your-project-id"
REGION="us-central1"
STAGING_BUCKET="your-dataproc-staging-bucket"
STATE_BUCKET="your-terraform-state-bucket"
SUBNET="" # Optional: existing subnet URI. Leave empty to let Terraform create one.

# Export core variables
export PROJECT_ID
export REGION
export STAGING_BUCKET
export STATE_BUCKET
export SUBNET

# gcloud overrides (ensures gcloud targets the demo project and region)
export CLOUDSDK_CORE_PROJECT="${PROJECT_ID}"
export CLOUDSDK_COMPUTE_REGION="${REGION}"

# Google Cloud SDK and Application Default Credentials (ADC) quota project
export GOOGLE_CLOUD_PROJECT="${PROJECT_ID}"
export GOOGLE_CLOUD_QUOTA_PROJECT="${PROJECT_ID}"

# Terraform variables
export TF_VAR_project_id="${PROJECT_ID}"
export TF_VAR_region="${REGION}"
export TF_VAR_staging_bucket="${STAGING_BUCKET}"
export TF_VAR_state_bucket="${STATE_BUCKET}"
export TF_VAR_subnet="${SUBNET}"
