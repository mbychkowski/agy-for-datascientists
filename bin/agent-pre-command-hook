#!/usr/bin/env bash
# ==============================================================================
# Antigravity PreToolUse Guardrail Hook Wrapper
#
# Delegates to the canonical ds-command-center plugin guardrail hook:
#   .agents/plugins/ds-command-center/bin/guardrail-hook
# ==============================================================================

set -uo pipefail

# Resolve real script directory through any symlinks (CODING_STANDARDS.md §1)
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "${SOURCE}" ]]; do
    DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
export REPO_ROOT

exec "${REPO_ROOT}/.agents/plugins/ds-command-center/bin/guardrail-hook" "$@"
