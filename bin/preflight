#!/usr/bin/env bash
# ==============================================================================
# Antigravity Command Center Preflight Check
#
# Validates environment configuration, GCP project pinning, ADC identity,
# and system prerequisites before running the live demo.
# ==============================================================================

set -uo pipefail

# Resolve real script directory through any symlinks
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "${SOURCE}" ]]; do
    DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# shellcheck source=lib/pinning.sh
source "${SCRIPT_DIR}/lib/pinning.sh"

# Color formatting if connected to a terminal
if [[ -t 1 ]]; then
    COLOR_GREEN="\033[0;32m"
    COLOR_RED="\033[0;31m"
    COLOR_YELLOW="\033[0;33m"
    COLOR_RESET="\033[0m"
else
    COLOR_GREEN=""
    COLOR_RED=""
    COLOR_YELLOW=""
    COLOR_RESET=""
fi

ENV_FILE="${REPO_ROOT}/demo.env"
ENV_LOAD_MESSAGES=""
CHECKS_PASSED=0
CHECKS_FAILED=0
CHECKS_WARNED=0
FAILED_MESSAGES=()

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --env|-e)
            ENV_FILE="$2"
            shift 2
            ;;
        --help|-h)
            echo "Usage: ./preflight [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  -e, --env <path>   Path to environment file (default: demo.env)"
            echo "  -h, --help         Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

# Shared runner for [PASS] / [FAIL] / [WARN] checks
_execute_check() {
    local severity="$1"
    local title="$2"
    local check_fn="$3"
    shift 3

    local output
    if output=$("$check_fn" "$@" 2>&1); then
        printf "${COLOR_GREEN}[PASS]${COLOR_RESET} %s\n" "${title}"
        ((CHECKS_PASSED++))
        return 0
    fi

    if [[ "${severity}" == "WARN" ]]; then
        printf "${COLOR_YELLOW}[WARN]${COLOR_RESET} %s\n" "${title}"
        ((CHECKS_WARNED++))
    else
        printf "${COLOR_RED}[FAIL]${COLOR_RESET} %s\n" "${title}"
        ((CHECKS_FAILED++))
        FAILED_MESSAGES+=("${title}")
    fi

    if [[ -n "${output}" ]]; then
        # Pinning module messages carry their own "[FAIL] " prefix; the check title
        # already reports the status, so indent them without repeating it.
        while IFS= read -r line; do
            printf "       %s\n" "${line#\[FAIL\] }"
        done <<< "${output}"
    fi
}

# Run a check function and record pass/fail
run_check() {
    _execute_check "FAIL" "$@"
}

# Run a warning check function (records [PASS] or [WARN] without failing preflight)
run_warn_check() {
    _execute_check "WARN" "$@"
}

# ------------------------------------------------------------------------------
# Environment Loading (main shell, once)
# ------------------------------------------------------------------------------
# Loads ENV_FILE through the Pinning module into the main shell so every check
# subshell inherits it. The loader's [FAIL] messages are kept in
# ENV_LOAD_MESSAGES for check 1 to report, rather than printed out of order.
load_environment() {
    local messages_file
    if ! messages_file="$(mktemp "${TMPDIR:-/tmp}/preflight-env.XXXXXX")"; then
        pinned_load_env "${ENV_FILE}"
        return
    fi
    pinned_load_env "${ENV_FILE}" 2>"${messages_file}"
    local status=$?
    ENV_LOAD_MESSAGES="$(cat "${messages_file}")"
    rm -f "${messages_file}"
    return "${status}"
}

# Re-validates the already-loaded PROJECT_ID and REGION through the Pinning
# guard (no reload). On failure prints a remediation hint, optionally followed
# by "and run: <command>".
# Usage: guard_project_region [<remediation command>]
guard_project_region() {
    if pinned_require_project_region; then
        return 0
    fi
    echo "Configure PROJECT_ID and REGION in ${ENV_FILE}${1:+ and run: $1}"
    return 1
}

# ------------------------------------------------------------------------------
# Check 1: Environment File Existence & Loading
# ------------------------------------------------------------------------------
check_env_file_exists() {
    if [[ ! -f "${ENV_FILE}" ]]; then
        echo "${ENV_LOAD_MESSAGES}"
        echo "Copy demo.env.example to demo.env and configure your environment:"
        echo "  cp demo.env.example demo.env"
        return 1
    fi
    return 0
}

# ------------------------------------------------------------------------------
# Check 2: Environment Variables & Overrides
# ------------------------------------------------------------------------------
check_env_variables() {
    if [[ ! -f "${ENV_FILE}" ]]; then
        echo "Environment file missing: ${ENV_FILE}"
        return 1
    fi

    # Verify required core variables are set and not placeholders
    if ! pinned_require_project_region ||
        ! pinned_require_staging_bucket ||
        ! pinned_require_state_bucket; then
        echo "Please set real Google Cloud project and bucket names in ${ENV_FILE}."
        return 1
    fi

    # Verify required overrides are exported and match core variables
    local overrides=(
        "CLOUDSDK_CORE_PROJECT:${PROJECT_ID}"
        "CLOUDSDK_COMPUTE_REGION:${REGION}"
        "GOOGLE_CLOUD_PROJECT:${PROJECT_ID}"
        "GOOGLE_CLOUD_QUOTA_PROJECT:${PROJECT_ID}"
        "TF_VAR_project_id:${PROJECT_ID}"
        "TF_VAR_region:${REGION}"
        "TF_VAR_staging_bucket:${STAGING_BUCKET}"
        "TF_VAR_state_bucket:${STATE_BUCKET}"
    )
    for entry in "${overrides[@]}"; do
        local var_name="${entry%%:*}"
        local expected_val="${entry#*:}"
        local actual_val="${!var_name:-}"
        if [[ "${actual_val}" != "${expected_val}" ]]; then
            echo "${var_name} ('${actual_val}') does not match expected value ('${expected_val}')"
            return 1
        fi
        if ! declare -p "${var_name}" 2>/dev/null | grep -q -- "-x"; then
            echo "${var_name} is set but not exported. Ensure 'export ${var_name}' is in ${ENV_FILE}"
            return 1
        fi
    done

    return 0
}

# ------------------------------------------------------------------------------
# Check 3: Active gcloud Project Pinning
# ------------------------------------------------------------------------------
check_active_gcloud_project() {
    pinned_require_cli gcloud || return 1
    guard_project_region || return 1

    # Read the active configuration's project property, ignoring any environment overrides
    local active_project
    active_project=$(pinned_gcloud_profile core/project 2>/dev/null || true)

    if [[ -z "${active_project}" ]]; then
        echo "No active gcloud project configured."
        echo "Run: gcloud config set project ${PROJECT_ID}"
        return 1
    fi

    if [[ "${active_project}" != "${PROJECT_ID}" ]]; then
        echo "Active gcloud project ('${active_project}') does not match environment file PROJECT_ID ('${PROJECT_ID}')."
        echo "Run: gcloud config set project ${PROJECT_ID}"
        return 1
    fi

    # Check active compute region if configured in gcloud
    local active_region
    active_region=$(pinned_gcloud_profile compute/region 2>/dev/null || true)
    if [[ -n "${active_region}" ]] && [[ "${active_region}" != "${REGION}" ]]; then
        echo "Active gcloud compute/region ('${active_region}') does not match environment file REGION ('${REGION}')."
        echo "Run: gcloud config set compute/region ${REGION}"
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 4: ADC Quota Project Pinning & Validity
# ------------------------------------------------------------------------------
check_adc_quota_project() {
    pinned_require_cli gcloud || return 1
    guard_project_region || return 1

    local adc_file="${GOOGLE_APPLICATION_CREDENTIALS:-${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}/application_default_credentials.json}"
    if [[ ! -f "${adc_file}" ]]; then
        echo "Application Default Credentials (ADC) file not found at: ${adc_file}"
        echo "Run: gcloud auth application-default login"
        return 1
    fi

    # Extract quota_project_id from ADC JSON
    local adc_quota
    adc_quota=$(python3 -c "
import json, sys
try:
    with open('${adc_file}') as f:
        data = json.load(f)
    print(data.get('quota_project_id', ''))
except Exception as e:
    sys.exit(1)
" 2>/dev/null || true)

    if [[ -z "${adc_quota}" ]]; then
        echo "No quota_project_id configured in ADC credentials (${adc_file})."
        echo "Run: gcloud auth application-default set-quota-project ${PROJECT_ID}"
        return 1
    fi

    if [[ "${adc_quota}" != "${PROJECT_ID}" ]]; then
        echo "ADC quota project ('${adc_quota}') does not match environment file PROJECT_ID ('${PROJECT_ID}')."
        echo "A mismatched quota project is the cause of BigQuery MCP's opaque Forbidden errors."
        echo "Run: gcloud auth application-default set-quota-project ${PROJECT_ID}"
        return 1
    fi

    # Check whether the quota project is active or stale/deleted
    local project_state
    if ! project_state=$(pinned_project_lifecycle_state "${adc_quota}" 2>&1); then
        echo "ADC quota project ('${adc_quota}') is inaccessible, stale, or deleted."
        echo "A stale or deleted quota project is the cause of BigQuery MCP's opaque Forbidden errors."
        echo "Error details: ${project_state}"
        echo "Verify that project '${adc_quota}' exists and is accessible to your account, or update PROJECT_ID in ${ENV_FILE}."
        return 1
    fi

    if [[ "${project_state}" != "ACTIVE" ]]; then
        echo "ADC quota project ('${adc_quota}') lifecycle state is '${project_state}' (expected ACTIVE)."
        echo "A stale or deleted quota project is the cause of BigQuery MCP's opaque Forbidden errors."
        echo "Verify that project '${adc_quota}' is active in Google Cloud Console."
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 5: Dataproc Serverless Runtime 3.0 Hello-World Batch Writes to BigQuery
# ------------------------------------------------------------------------------
check_dataproc_hello_world_batch() {
    pinned_require_cli gcloud bq || return 1
    guard_project_region "terraform -chdir=infra apply" || return 1

    if ! pinned_require_staging_bucket; then
        echo "Configure STAGING_BUCKET in ${ENV_FILE} and run: terraform -chdir=infra apply"
        return 1
    fi

    local hello_script="${REPO_ROOT}/bin/dataproc_hello_world.py"
    if [[ ! -f "${hello_script}" ]]; then
        echo "Dataproc hello-world script not found at: ${hello_script}"
        return 1
    fi

    local subnet_target="${SUBNET:-demo-dataproc-subnet}"
    local batch_id="${PREFLIGHT_BATCH_ID:-preflight-hello-$$}"
    local temp_table="${PREFLIGHT_HELLO_TABLE:-_preflight_hello_$$}"

    cleanup_hello_world() {
        pinned_bq rm -f -t "${PROJECT_ID}:staging.${temp_table}" >/dev/null 2>&1 || true
        pinned_dataproc_delete "${batch_id}" >/dev/null 2>&1 || true
    }

    local submit_out
    if ! submit_out=$(pinned_dataproc_submit "${hello_script}" "${batch_id}" -- \
        --project-id "${PROJECT_ID}" \
        --dataset "staging" \
        --table "${temp_table}" \
        --staging-bucket "${STAGING_BUCKET}" 2>&1); then
        echo "Dataproc Serverless runtime 3.0 hello-world batch failed to execute."
        echo "Verify that Terraform has been applied ('terraform -chdir=infra apply'), Private Google Access is enabled on '${subnet_target}', and Shielded VM org policy constraints are satisfied."
        echo "Error details: ${submit_out}"
        cleanup_hello_world
        return 1
    fi

    local bq_out
    if ! bq_out=$(pinned_bq show "${PROJECT_ID}:staging.${temp_table}" 2>&1); then
        echo "Dataproc hello-world batch completed, but verification table '${PROJECT_ID}:staging.${temp_table}' was not found in BigQuery."
        echo "Error details: ${bq_out}"
        cleanup_hello_world
        return 1
    fi

    cleanup_hello_world
    return 0
}

# ------------------------------------------------------------------------------
# Check 6: BigQuery MCP Authenticates as Presenter (No Compute Metadata Fallback)
# ------------------------------------------------------------------------------
check_bigquery_mcp_presenter_auth() {
    local plugin_dir="${REPO_ROOT}/.agents/plugins/dak-bigquery"
    local plugin_json="${plugin_dir}/plugin.json"
    local mcp_config="${plugin_dir}/mcp_config.json"
    local wrapper_bin="${plugin_dir}/bin/run-bigquery-mcp"
    local vendored_proxy="${plugin_dir}/mcp/bin/mcp_proxy_bundle.cjs"

    for required_file in "${plugin_json}" "${mcp_config}" "${wrapper_bin}" "${vendored_proxy}"; do
        if [[ ! -f "${required_file}" ]]; then
            echo "Required dak-bigquery plugin file missing: ${required_file}"
            return 1
        fi
    done

    if [[ ! -x "${wrapper_bin}" ]]; then
        echo "BigQuery MCP wrapper is not executable: ${wrapper_bin}"
        return 1
    fi

    guard_project_region || return 1

    local wrapper_env
    if ! wrapper_env=$(DEMO_ENV_FILE="${ENV_FILE}" "${wrapper_bin}" --print-env 2>&1); then
        echo "BigQuery MCP wrapper failed to load ${ENV_FILE}: ${wrapper_env}"
        return 1
    fi

    if [[ "${wrapper_env}" != *"BILLING_QUOTA_PROJECT_ID=${PROJECT_ID}"* ]]; then
        echo "BigQuery MCP wrapper did not set BILLING_QUOTA_PROJECT_ID=${PROJECT_ID}."
        return 1
    fi

    # Verify active gcloud identity is a presenter user account, not a compute service account
    pinned_require_cli gcloud || return 1

    local active_account
    active_account=$(pinned_gcloud_profile core/account 2>/dev/null || true)
    if [[ -z "${active_account}" ]]; then
        echo "No active gcloud account configured."
        echo "BigQuery MCP must authenticate as the presenter. Run: gcloud auth login"
        return 1
    fi
    if [[ "${active_account}" == *".gserviceaccount.com" ]]; then
        echo "Active gcloud account ('${active_account}') is a service account rather than the presenter's user identity."
        echo "BigQuery MCP must authenticate as the presenter. Run: gcloud auth login"
        return 1
    fi

    # Inspect ADC JSON to ensure user OAuth credentials are present so mcp_proxy_bundle.cjs
    # cannot silently fall back to http://metadata.google.internal/... service account token
    local adc_file="${GOOGLE_APPLICATION_CREDENTIALS:-${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}/application_default_credentials.json}"
    if [[ ! -f "${adc_file}" ]]; then
        echo "ADC file not found at ${adc_file}. Without user ADC, BigQuery MCP silently falls back to the compute metadata service account."
        echo "Run: gcloud auth application-default login"
        return 1
    fi

    local adc_check
    if ! adc_check=$(python3 -c "
import json, sys
with open('${adc_file}') as f:
    data = json.load(f)
cred_type = data.get('type', '')
if cred_type == 'service_account':
    print('ADC file has type=service_account; BigQuery MCP requires presenter user credentials (authorized_user).')
    sys.exit(1)
missing = [k for k in ('client_id', 'client_secret', 'refresh_token') if not isinstance(data.get(k), str) or not data.get(k).strip()]
if missing:
    print('ADC credentials file is missing user OAuth fields (' + ', '.join(missing) + ').')
    sys.exit(1)
" 2>&1); then
        echo "${adc_check}"
        echo "When user ADC fails validation, mcp_proxy_bundle.cjs silently falls back to the compute metadata service account identity."
        echo "Run: gcloud auth application-default login"
        return 1
    fi

    if ! pinned_adc_token_ok; then
        echo "ADC refresh token is expired or revoked and cannot mint an access token."
        echo "When user ADC token refresh fails, mcp_proxy_bundle.cjs silently falls back to the compute metadata service account identity."
        echo "Run: gcloud auth application-default login"
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 7: ds-command-center Plugin Rules & Dataset Boundary Guardrail Hook
# ------------------------------------------------------------------------------
check_ds_command_center_guardrails() {
    local plugin_dir="${REPO_ROOT}/.agents/plugins/ds-command-center"
    local plugin_json="${plugin_dir}/plugin.json"
    local hooks_json="${plugin_dir}/hooks.json"
    local rules_md="${plugin_dir}/rules/AGENTS.md"
    local guardrail_bin="${plugin_dir}/bin/guardrail-hook"

    for required_file in "${plugin_json}" "${hooks_json}" "${rules_md}" "${guardrail_bin}"; do
        if [[ ! -f "${required_file}" ]]; then
            echo "Required ds-command-center plugin file missing: ${required_file}"
            return 1
        fi
    done

    if [[ ! -x "${guardrail_bin}" ]]; then
        echo "ds-command-center guardrail hook is not executable: ${guardrail_bin}"
        echo "Run: chmod +x ${guardrail_bin}"
        return 1
    fi

    local probe_out
    if ! probe_out=$(python3 -c "
import json, subprocess, sys

hook_bin = '${guardrail_bin}'

probes = [
    (
        'bq DML/DDL targeting raw',
        {'toolCall': {'name': 'run_command', 'args': {'CommandLine': 'bq query --use_legacy_sql=false \"DROP TABLE raw.hospital_flu_feeds\"'}}},  # pinning-guard: allow (hook probe payload, not a bq call)
        'deny',
        'read-only',
    ),
    (
        'BigQuery MCP execute_sql DML targeting ops',
        {'toolCall': {'name': 'execute_sql', 'args': {'sql': 'DELETE FROM ops.pipeline_run_log WHERE true'}}},  # dataset-guard: allow (hook probe payload, not a query)
        'deny',
        'read-only',
    ),
    (
        'BigQuery MCP execute_sql read targeting checkpoint',
        {'toolCall': {'name': 'execute_sql', 'args': {'sql': 'SELECT * FROM checkpoint.clean_feeds'}}},  # dataset-guard: allow (hook probe payload, not a query)
        'deny',
        'read-only',
    ),
    (
        'Shell bq read targeting checkpoint',
        {'toolCall': {'name': 'run_command', 'args': {'CommandLine': 'bq query --use_legacy_sql=false \"SELECT * FROM checkpoint.clean_feeds\"'}}},  # pinning-guard: allow (hook probe payload, not a bq call)
        'deny',
        'read-only',
    ),
    (
        'BigQuery MCP execute_sql read targeting raw',
        {'toolCall': {'name': 'execute_sql', 'args': {'sql': 'SELECT COUNT(*) FROM raw.hospital_flu_feeds'}}},
        'allow',
        None,
    ),
    (
        'Shell bq read targeting ops',
        {'toolCall': {'name': 'run_command', 'args': {'CommandLine': 'bq query --use_legacy_sql=false \"SELECT * FROM ops.pipeline_run_log LIMIT 5\"'}}},  # pinning-guard: allow (hook probe payload, not a bq call)
        'allow',
        None,
    ),
]

for label, payload, expected_decision, expected_substr in probes:
    proc = subprocess.run(
        [hook_bin],
        input=json.dumps(payload),
        text=True,
        capture_output=True,
        check=False,
    )
    if proc.returncode != 0:
        print(f'Guardrail hook exited with code {proc.returncode} on probe: {label}')
        sys.exit(1)
    try:
        resp = json.loads(proc.stdout.strip())
    except Exception as exc:
        print(f'Guardrail hook returned invalid JSON on probe ({label}): {proc.stdout!r} ({exc})')
        sys.exit(1)
    actual_decision = resp.get('decision')
    if actual_decision != expected_decision:
        print(f'Guardrail hook probe failed ({label}): expected decision={expected_decision!r}, got {actual_decision!r}')
        sys.exit(1)
    if expected_substr:
        reason = resp.get('reason', '')
        if expected_substr not in reason.lower():
            print(f'Guardrail hook probe ({label}) missing {expected_substr!r} in reason: {reason!r}')
            sys.exit(1)
" 2>&1); then
        echo "${probe_out}"
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 8: BigQuery AI.FORECAST (TimesFM) Executes on a Tiny Series
# ------------------------------------------------------------------------------
check_bqml_timesfm_forecast() {
    pinned_require_cli bq || return 1
    guard_project_region "terraform -chdir=infra apply" || return 1

    local forecast_out
    if ! forecast_out=$(pinned_bq query \
        --quiet \
        --use_legacy_sql=false \
        --format=json \
        "SELECT forecast_timestamp, forecast_value FROM AI.FORECAST((SELECT dt AS ts, CAST(10 + idx AS FLOAT64) AS val FROM UNNEST(GENERATE_DATE_ARRAY(DATE '2026-10-01', DATE '2026-10-14')) AS dt WITH OFFSET AS idx), data_col => 'val', timestamp_col => 'ts', horizon => 3)" 2>&1); then
        echo "BigQuery AI.FORECAST (TimesFM) query failed in project '${PROJECT_ID}' (${REGION})."
        echo "Ensure Vertex AI and BigQuery APIs are enabled ('terraform -chdir=infra apply') and AI.FORECAST is available in '${REGION}'."
        echo "Error details: ${forecast_out}"
        return 1
    fi

    local forecast_json
    if ! forecast_json=$(pinned_bq_json "${forecast_out}" 2>&1); then
        echo "AI.FORECAST output contains no JSON result."
        echo "Actual output: ${forecast_out}"
        return 1
    fi

    local validate_out
    if ! validate_out=$(python3 -c '
import json, sys
rows = json.loads(sys.argv[1])
if not isinstance(rows, list) or len(rows) == 0:
    print("AI.FORECAST returned an empty or non-list result.")
    sys.exit(1)
first = rows[0]
if not isinstance(first, dict) or "forecast_value" not in first:
    print("AI.FORECAST output is missing expected forecast_value field.")
    sys.exit(1)
' "${forecast_json}" 2>&1); then
        echo "${validate_out}"
        echo "Actual output: ${forecast_out}"
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 9: BigQuery ML K-Means Model Trains and Cleans Up in ml Dataset
# ------------------------------------------------------------------------------
check_bqml_kmeans_model() {
    pinned_require_cli bq || return 1
    guard_project_region "terraform -chdir=infra apply" || return 1

    local temp_model="${PREFLIGHT_KMEANS_MODEL:-_preflight_kmeans_$$}"

    cleanup_kmeans_model() {
        pinned_bq rm -f -m "${PROJECT_ID}:ml.${temp_model}" >/dev/null 2>&1 || true
    }

    local kmeans_out
    if ! kmeans_out=$(pinned_bq query \
        --quiet \
        --use_legacy_sql=false \
        "CREATE OR REPLACE MODEL \`${PROJECT_ID}.ml.${temp_model}\` OPTIONS(model_type='KMEANS', num_clusters=2, max_iterations=2) AS SELECT CAST(x AS FLOAT64) AS f1, CAST(y AS FLOAT64) AS f2 FROM UNNEST([STRUCT(1.0 AS x, 1.0 AS y), STRUCT(1.2 AS x, 0.9 AS y), STRUCT(10.0 AS x, 10.0 AS y), STRUCT(10.5 AS x, 9.8 AS y)])" 2>&1); then
        echo "BigQuery ML K-means model training failed in '${PROJECT_ID}:ml.${temp_model}' (${REGION})."
        echo "Verify that dataset 'ml' exists ('terraform -chdir=infra apply') and you have BigQuery ML permissions."
        echo "Error details: ${kmeans_out}"
        cleanup_kmeans_model
        return 1
    fi

    local rm_out
    if ! rm_out=$(pinned_bq rm -f -m "${PROJECT_ID}:ml.${temp_model}" 2>&1); then
        echo "BigQuery ML K-means model trained, but removing temporary model '${PROJECT_ID}:ml.${temp_model}' failed."
        echo "Error details: ${rm_out}"
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 10: Subagent Dispatches and Returns via Antigravity Harness
# ------------------------------------------------------------------------------
check_subagent_dispatch() {
    pinned_require_cli agy || return 1

    local agy_timeout="${PREFLIGHT_AGY_TIMEOUT:-60s}"
    local subagent_out
    if ! subagent_out=$(agy --print-timeout "${agy_timeout}" --print="Dispatch a research subagent with the prompt 'Reply with SUBAGENT_OK' and print SUBAGENT_OK when it returns." 2>&1); then
        echo "Antigravity CLI subagent dispatch failed."
        echo "Error details: ${subagent_out}"
        echo "Manual fallback check: In the Antigravity IDE chat panel, ask the agent to dispatch a research subagent and confirm it returns in the Subagents pane."
        return 1
    fi
    if [[ "${subagent_out}" != *"SUBAGENT_OK"* ]]; then
        echo "Subagent dispatch did not return expected confirmation token 'SUBAGENT_OK'."
        echo "Actual output: ${subagent_out}"
        echo "Manual fallback check: In the Antigravity IDE chat panel, ask the agent to dispatch a research subagent and confirm it returns in the Subagents pane."
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 11: Fresh Agent Sees Data Agent Kit Skills Installed in the Workspace
# ------------------------------------------------------------------------------
check_workspace_dak_skills_visibility() {
    local skills_json="${REPO_ROOT}/.agents/skills.json"
    if [[ ! -f "${skills_json}" ]]; then
        echo "Workspace skills configuration file not found: ${skills_json}"
        return 1
    fi
    if ! grep -q ".gemini/skills" "${skills_json}"; then
        echo "Workspace skills configuration (${skills_json}) does not reference '.gemini/skills'."
        return 1
    fi

    local skills_dir="${WORKSPACE_DAK_SKILLS_DIR:-${REPO_ROOT}/.gemini/skills}"
    if [[ ! -d "${skills_dir}" ]] || { [[ ! -f "${skills_dir}/bigquery-ai-ml/SKILL.md" ]] && [[ ! -f "${skills_dir}/gcp-spark/SKILL.md" ]] && [[ ! -f "${skills_dir}/bigquery-sql/SKILL.md" ]]; }; then
        echo "Workspace Data Agent Kit skills not found in: ${skills_dir}"
        echo "Install Data Agent Kit skills into the workspace (.gemini/skills/) before presenting."
        return 1
    fi

    pinned_require_cli agy || return 1

    local agy_timeout="${PREFLIGHT_AGY_TIMEOUT:-60s}"
    local skills_out
    if ! skills_out=$(agy --print-timeout "${agy_timeout}" --print="Confirm whether Data Agent Kit skills (such as bigquery-ai-ml or gcp-spark) are visible in this workspace and reply with DAK_SKILLS_VISIBLE." 2>&1); then
        echo "Fresh agent invocation failed while checking workspace Data Agent Kit skills."
        echo "Error details: ${skills_out}"
        return 1
    fi
    if [[ "${skills_out}" != *"DAK_SKILLS_VISIBLE"* ]]; then
        echo "Fresh agent did not report Data Agent Kit skills as visible in the workspace."
        echo "Actual output: ${skills_out}"
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 12: Java 21 Runtime Available for Local Spark 4 Testing
# ------------------------------------------------------------------------------
check_java_21_available() {
    local check_out
    if ! check_out=$(python3 -c '
import os, sys
from pathlib import Path
sys.path.insert(0, str(Path(sys.argv[1])))
from pipelines.pipeline_clean import ensure_java_21_env

try:
    ensure_java_21_env(dict(os.environ))
except RuntimeError as exc:
    print(str(exc))
    sys.exit(1)
' "${REPO_ROOT}" 2>&1); then
        echo "${check_out}"
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 13 (Warning): Vendored BigQuery MCP Proxy Drift Check
# ------------------------------------------------------------------------------
check_vendored_proxy_drift() {
    local vendored_proxy="${REPO_ROOT}/.agents/plugins/dak-bigquery/mcp/bin/mcp_proxy_bundle.cjs"
    if [[ ! -f "${vendored_proxy}" ]]; then
        echo "Vendored BigQuery MCP proxy missing at: ${vendored_proxy}"
        return 1
    fi

    local default_dak_dir="${HOME}/.gemini/config/plugins/data-agent-kit-plugin"
    local dak_dir="${DAK_PLUGIN_DIR:-${default_dak_dir}}"
    local installed_proxy="${dak_dir}/mcp/bin/mcp_proxy_bundle.cjs"

    if [[ ! -f "${installed_proxy}" ]]; then
        echo "Installed Data Agent Kit proxy not found at: ${installed_proxy} (skipping SHA-256 comparison; using vendored copy)."
        return 1
    fi

    local drift_msg
    if ! drift_msg=$(python3 -c "
import hashlib, sys
from pathlib import Path
v_path = Path('${vendored_proxy}')
i_path = Path('${installed_proxy}')
v_hash = hashlib.sha256(v_path.read_bytes()).hexdigest()
i_hash = hashlib.sha256(i_path.read_bytes()).hexdigest()
if v_hash != i_hash:
    print(f'Vendored proxy SHA-256 ({v_hash[:12]}...) differs from installed Data Agent Kit proxy ({i_hash[:12]}...).')
    print(f'To sync with your installed Data Agent Kit, run:')
    print(f'  cp \"{i_path}\" \"{v_path}\"')
    sys.exit(1)
" 2>&1); then
        echo "${drift_msg}"
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 14 (Warning): Evidence Board Sidecar Installed, Current and Enabled
# ------------------------------------------------------------------------------
# Read-only: confirms the once-per-machine install (DEMO.md Step 0b) landed at
# ~/.gemini/config/sidecars/evidence-board/, still matches the repo source, is
# pinned to a workspace holding demo.env, and is enabled in config.json. It never
# installs or enables anything; the standalone ./evidence-board stays the fallback.
check_evidence_board_sidecar() {
    local config_dir="${PREFLIGHT_GEMINI_CONFIG_DIR:-${HOME}/.gemini/config}"
    python3 - \
        "${REPO_ROOT}/.agents/plugins/ds-command-center/sidecars/evidence-board" \
        "${config_dir}/sidecars/evidence-board" \
        "${config_dir}/config.json" <<'PY'
import json
import os
import sys
from pathlib import Path

source, installed, config = (Path(arg) for arg in sys.argv[1:4])
fix = "./install-evidence-board --workspace ~/demo-stage/agy-ws1"
if not (installed / "sidecar.json").is_file():
    print(f"Evidence Board sidecar is not installed at {installed}.")
    print(f"Install it once per machine (DEMO.md Step 0b): {fix}")
    sys.exit(1)

problems = []
settings = {}
install_env = installed / "install.env"
if install_env.is_file():
    for line in install_env.read_text(encoding="utf-8").splitlines():
        key, sep, value = line.partition("=")
        if sep:
            settings[key] = value
workspace = settings.get("WORKSPACE", "")
if not workspace or not (Path(workspace) / "demo.env").is_file():
    problems.append(
        f"The installed board's workspace ({workspace or 'unset'}) has no demo.env;"
        f" reinstall with: {fix}"
    )

# Compare the files the installer copies, both ways (a module the repo dropped
# but the install kept stays importable). Build output and leftovers are skipped;
# the frontend bundle is checked for presence instead.
skipped_dirs = {"node_modules", "__pycache__", "dist"}


def tracked_files(top):
    found = {}
    for root, dirs, files in os.walk(top):
        dirs[:] = sorted(d for d in dirs if d not in skipped_dirs)
        for name in files:
            path = Path(root) / name
            rel = path.relative_to(top).as_posix()
            if not name.endswith(".tsbuildinfo") and rel != "install.env":
                found[rel] = path
    return found


repo_files, installed_files = tracked_files(source), tracked_files(installed)
differing = sorted(
    rel
    for rel in repo_files.keys() | installed_files.keys()
    if rel not in repo_files
    or rel not in installed_files
    or repo_files[rel].read_bytes() != installed_files[rel].read_bytes()
)
if differing:
    problems.append(
        f"The installed board is out of date with the repo ({len(differing)} file(s)"
        f" differ, first: {differing[0]}); rerun: {fix}"
    )

if not (installed / "frontend" / "dist" / "index.html").is_file():
    problems.append(
        "The installed board has no frontend bundle (frontend/dist/index.html);"
        f" rerun without --no-build: {fix}"
    )

try:
    entry = json.loads(config.read_text(encoding="utf-8"))["sidecars"]["evidence-board"]
    enabled = entry.get("enabled") is True
except (OSError, ValueError, KeyError, TypeError, AttributeError):
    enabled = False
if not enabled:
    problems.append(
        "The sidecar is not enabled. Merge"
        ' {"sidecars": {"evidence-board": {"enabled": true}}}'
        f" into {config}, then restart the Antigravity App."
    )

for problem in problems:
    print(problem)
sys.exit(1 if problems else 0)
PY
}

# ------------------------------------------------------------------------------
# Main Preflight Runner
# ------------------------------------------------------------------------------
main() {
    echo "=================================================="
    echo "       Command Center Preflight Verification      "
    echo "=================================================="
    echo "Environment file: ${ENV_FILE}"
    echo ""

    # Load demo.env once into this shell; each check subshell re-validates it
    # through the Pinning guard instead of reloading the file.
    load_environment

    # Check 1: File exists
    run_check "Environment file exists" check_env_file_exists

    # Check 2: Environment variables and exported overrides
    run_check "Environment variables and overrides configured" check_env_variables

    # Check 3: Active gcloud project and region pinning
    run_check "Active gcloud project and region match environment" check_active_gcloud_project

    # Check 4: ADC quota project pinning and validity
    run_check "ADC quota project matches PROJECT_ID and is active" check_adc_quota_project

    # Check 5: Dataproc Serverless runtime 3.0 hello-world batch writing to BigQuery
    run_check "Dataproc Serverless runtime 3.0 hello-world batch writes to BigQuery" check_dataproc_hello_world_batch

    # Check 6: BigQuery MCP authenticates as presenter (no compute metadata fallback)
    run_check "BigQuery MCP authenticates as presenter (no compute metadata fallback)" check_bigquery_mcp_presenter_auth

    # Check 7: ds-command-center plugin rules and guardrail hook enforce dataset boundaries
    run_check "ds-command-center plugin rules and guardrail hook enforce dataset boundaries" check_ds_command_center_guardrails

    # Check 8: BigQuery AI.FORECAST (TimesFM) executes on a tiny series
    run_check "BigQuery AI.FORECAST (TimesFM) executes on a tiny series" check_bqml_timesfm_forecast

    # Check 9: BigQuery ML K-means model trains and cleans up in ml dataset
    run_check "BigQuery ML K-means model trains and cleans up in ml dataset" check_bqml_kmeans_model

    # Check 10: Subagent dispatches and returns via Antigravity harness
    run_check "Subagent dispatches and returns via Antigravity harness" check_subagent_dispatch

    # Check 11: Fresh agent sees Data Agent Kit skills installed in the workspace
    run_check "Fresh agent sees Data Agent Kit skills installed in the workspace" check_workspace_dak_skills_visibility

    # Check 12: Java 21 runtime is available for local Spark 4 testing
    run_check "Java 21 runtime is available for local Spark 4 testing" check_java_21_available

    # Check 13 (Warning): Vendored BigQuery MCP proxy matches installed Data Agent Kit
    run_warn_check "Vendored BigQuery MCP proxy matches installed Data Agent Kit" check_vendored_proxy_drift

    # Check 14 (Warning): Evidence Board sidecar is installed, current and enabled
    run_warn_check "Evidence Board sidecar is installed, current and enabled" check_evidence_board_sidecar

    echo ""
    echo "Manual Verification Steps (Not Scriptable by CLI Harness):"
    printf "  ${COLOR_YELLOW}[MANUAL]${COLOR_RESET} VS Code Data Agent Kit UI: Submit and inspect a Dataproc Serverless batch in the VS Code extension panel.\n"
    printf "  ${COLOR_YELLOW}[MANUAL]${COLOR_RESET} Antigravity IDE UI: Confirm the Subagents pane and guardrail block banner render visually in the IDE.\n"

    echo ""
    echo "--------------------------------------------------"
    if [[ ${CHECKS_WARNED} -gt 0 ]]; then
        echo "Summary: ${CHECKS_PASSED} passed, ${CHECKS_FAILED} failed, ${CHECKS_WARNED} warning(s)."
    else
        echo "Summary: ${CHECKS_PASSED} passed, ${CHECKS_FAILED} failed."
    fi
    echo "--------------------------------------------------"

    if [[ ${CHECKS_FAILED} -gt 0 ]]; then
        exit 1
    fi
    exit 0
}

main "$@"
