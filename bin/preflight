#!/usr/bin/env bash
# ==============================================================================
# Antigravity Command Center Preflight Check
#
# Validates environment configuration, GCP project pinning, ADC identity,
# and system prerequisites before running the live demo.
# ==============================================================================

set -uo pipefail

# Resolve real script directory through any symlinks
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "${SOURCE}" ]]; do
    DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Color formatting if connected to a terminal
if [[ -t 1 ]]; then
    COLOR_GREEN="\033[0;32m"
    COLOR_RED="\033[0;31m"
    COLOR_YELLOW="\033[0;33m"
    COLOR_BOLD="\033[1m"
    COLOR_RESET="\033[0m"
else
    COLOR_GREEN=""
    COLOR_RED=""
    COLOR_YELLOW=""
    COLOR_BOLD=""
    COLOR_RESET=""
fi

ENV_FILE="${REPO_ROOT}/demo.env"
CHECKS_PASSED=0
CHECKS_FAILED=0
CHECKS_WARNED=0
FAILED_MESSAGES=()

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --env|-e)
            ENV_FILE="$2"
            shift 2
            ;;
        --help|-h)
            echo "Usage: ./preflight [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  -e, --env <path>   Path to environment file (default: demo.env)"
            echo "  -h, --help         Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

# Shared runner for [PASS] / [FAIL] / [WARN] checks
_execute_check() {
    local severity="$1"
    local title="$2"
    local check_fn="$3"
    shift 3

    local output
    if output=$("$check_fn" "$@" 2>&1); then
        printf "${COLOR_GREEN}[PASS]${COLOR_RESET} %s\n" "${title}"
        ((CHECKS_PASSED++))
        return 0
    fi

    if [[ "${severity}" == "WARN" ]]; then
        printf "${COLOR_YELLOW}[WARN]${COLOR_RESET} %s\n" "${title}"
        ((CHECKS_WARNED++))
    else
        printf "${COLOR_RED}[FAIL]${COLOR_RESET} %s\n" "${title}"
        ((CHECKS_FAILED++))
        FAILED_MESSAGES+=("${title}")
    fi

    if [[ -n "${output}" ]]; then
        while IFS= read -r line; do
            printf "       %s\n" "${line}"
        done <<< "${output}"
    fi
}

# Run a check function and record pass/fail
run_check() {
    _execute_check "FAIL" "$@"
}

# Run a warning check function (records [PASS] or [WARN] without failing preflight)
run_warn_check() {
    _execute_check "WARN" "$@"
}

# ------------------------------------------------------------------------------
# Check 1: Environment File Existence & Loading
# ------------------------------------------------------------------------------
check_env_file_exists() {
    if [[ ! -f "${ENV_FILE}" ]]; then
        echo "Environment file not found: ${ENV_FILE}"
        echo "Copy demo.env.example to demo.env and configure your environment:"
        echo "  cp demo.env.example demo.env"
        return 1
    fi
    return 0
}

# ------------------------------------------------------------------------------
# Check 2: Environment Variables & Overrides
# ------------------------------------------------------------------------------
check_env_variables() {
    if [[ ! -f "${ENV_FILE}" ]]; then
        echo "Environment file missing: ${ENV_FILE}"
        return 1
    fi

    # Source the environment file
    # shellcheck disable=SC1090
    source "${ENV_FILE}"

    # Verify required core variables are set and not empty
    local required_core=("PROJECT_ID" "REGION" "STAGING_BUCKET" "STATE_BUCKET")
    for var in "${required_core[@]}"; do
        if [[ -z "${!var:-}" ]]; then
            echo "Required variable '${var}' is unset or empty in ${ENV_FILE}"
            return 1
        fi
        # Check for unconfigured placeholders
        if [[ "${!var}" == *"your-"* ]] || [[ "${!var}" == "your-project-id" ]]; then
            echo "Variable '${var}' contains placeholder value '${!var}'."
            echo "Please set real Google Cloud project and bucket names in ${ENV_FILE}."
            return 1
        fi
    done

    # Verify required overrides are exported and match core variables
    local overrides=(
        "CLOUDSDK_CORE_PROJECT:${PROJECT_ID}"
        "CLOUDSDK_COMPUTE_REGION:${REGION}"
        "GOOGLE_CLOUD_PROJECT:${PROJECT_ID}"
        "GOOGLE_CLOUD_QUOTA_PROJECT:${PROJECT_ID}"
        "TF_VAR_project_id:${PROJECT_ID}"
        "TF_VAR_region:${REGION}"
        "TF_VAR_staging_bucket:${STAGING_BUCKET}"
        "TF_VAR_state_bucket:${STATE_BUCKET}"
    )
    for entry in "${overrides[@]}"; do
        local var_name="${entry%%:*}"
        local expected_val="${entry#*:}"
        local actual_val="${!var_name:-}"
        if [[ "${actual_val}" != "${expected_val}" ]]; then
            echo "${var_name} ('${actual_val}') does not match expected value ('${expected_val}')"
            return 1
        fi
        if ! declare -p "${var_name}" 2>/dev/null | grep -q -- "-x"; then
            echo "${var_name} is set but not exported. Ensure 'export ${var_name}' is in ${ENV_FILE}"
            return 1
        fi
    done

    return 0
}

# ------------------------------------------------------------------------------
# Check 3: Active gcloud Project Pinning
# ------------------------------------------------------------------------------
check_active_gcloud_project() {
    if ! command -v gcloud >/dev/null 2>&1; then
        echo "gcloud CLI is not installed or not in PATH."
        return 1
    fi

    if [[ -z "${PROJECT_ID:-}" ]] || [[ "${PROJECT_ID}" == *"your-"* ]]; then
        echo "PROJECT_ID is unset or contains placeholder value in ${ENV_FILE}."
        return 1
    fi

    # Read the active configuration's project property, ignoring any environment overrides
    local active_project
    active_project=$(env -u CLOUDSDK_CORE_PROJECT gcloud config configurations list --filter="is_active=true" --format="value(properties.core.project)" 2>/dev/null || true)

    if [[ -z "${active_project}" ]]; then
        echo "No active gcloud project configured."
        echo "Run: gcloud config set project ${PROJECT_ID}"
        return 1
    fi

    if [[ "${active_project}" != "${PROJECT_ID}" ]]; then
        echo "Active gcloud project ('${active_project}') does not match environment file PROJECT_ID ('${PROJECT_ID}')."
        echo "Run: gcloud config set project ${PROJECT_ID}"
        return 1
    fi

    # Check active compute region if configured in gcloud
    local active_region
    active_region=$(env -u CLOUDSDK_COMPUTE_REGION gcloud config configurations list --filter="is_active=true" --format="value(properties.compute.region)" 2>/dev/null || true)
    if [[ -n "${active_region}" ]] && [[ "${active_region}" != "${REGION}" ]]; then
        echo "Active gcloud compute/region ('${active_region}') does not match environment file REGION ('${REGION}')."
        echo "Run: gcloud config set compute/region ${REGION}"
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 4: ADC Quota Project Pinning & Validity
# ------------------------------------------------------------------------------
check_adc_quota_project() {
    if ! command -v gcloud >/dev/null 2>&1; then
        echo "gcloud CLI is not installed or not in PATH."
        return 1
    fi

    if [[ -z "${PROJECT_ID:-}" ]] || [[ "${PROJECT_ID}" == *"your-"* ]]; then
        echo "PROJECT_ID is unset or contains placeholder value in ${ENV_FILE}."
        return 1
    fi

    local adc_file="${GOOGLE_APPLICATION_CREDENTIALS:-${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}/application_default_credentials.json}"
    if [[ ! -f "${adc_file}" ]]; then
        echo "Application Default Credentials (ADC) file not found at: ${adc_file}"
        echo "Run: gcloud auth application-default login"
        return 1
    fi

    # Extract quota_project_id from ADC JSON
    local adc_quota
    adc_quota=$(python3 -c "
import json, sys
try:
    with open('${adc_file}') as f:
        data = json.load(f)
    print(data.get('quota_project_id', ''))
except Exception as e:
    sys.exit(1)
" 2>/dev/null || true)

    if [[ -z "${adc_quota}" ]]; then
        echo "No quota_project_id configured in ADC credentials (${adc_file})."
        echo "Run: gcloud auth application-default set-quota-project ${PROJECT_ID}"
        return 1
    fi

    if [[ "${adc_quota}" != "${PROJECT_ID}" ]]; then
        echo "ADC quota project ('${adc_quota}') does not match environment file PROJECT_ID ('${PROJECT_ID}')."
        echo "A mismatched quota project is the cause of BigQuery MCP's opaque Forbidden errors."
        echo "Run: gcloud auth application-default set-quota-project ${PROJECT_ID}"
        return 1
    fi

    # Check whether the quota project is active or stale/deleted
    local project_state
    if ! project_state=$(gcloud projects describe "${adc_quota}" --project "${PROJECT_ID}" --format="value(lifecycleState)" 2>&1); then
        echo "ADC quota project ('${adc_quota}') is inaccessible, stale, or deleted."
        echo "A stale or deleted quota project is the cause of BigQuery MCP's opaque Forbidden errors."
        echo "Error details: ${project_state}"
        echo "Verify that project '${adc_quota}' exists and is accessible to your account, or update PROJECT_ID in ${ENV_FILE}."
        return 1
    fi

    if [[ "${project_state}" != "ACTIVE" ]]; then
        echo "ADC quota project ('${adc_quota}') lifecycle state is '${project_state}' (expected ACTIVE)."
        echo "A stale or deleted quota project is the cause of BigQuery MCP's opaque Forbidden errors."
        echo "Verify that project '${adc_quota}' is active in Google Cloud Console."
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 5: Dataproc Serverless Runtime 3.0 Hello-World Batch Writes to BigQuery
# ------------------------------------------------------------------------------
check_dataproc_hello_world_batch() {
    if ! command -v gcloud >/dev/null 2>&1; then
        echo "gcloud CLI is not installed or not in PATH."
        return 1
    fi

    if ! command -v bq >/dev/null 2>&1; then
        echo "bq CLI is not installed or not in PATH."
        return 1
    fi

    if [[ -z "${PROJECT_ID:-}" ]] || [[ "${PROJECT_ID}" == *"your-"* ]]; then
        echo "PROJECT_ID is unset or contains placeholder value in ${ENV_FILE}."
        echo "Configure PROJECT_ID in ${ENV_FILE} and run: terraform -chdir=infra apply"
        return 1
    fi

    if [[ -z "${REGION:-}" ]] || [[ "${REGION}" == *"your-"* ]]; then
        echo "REGION is unset or contains placeholder value in ${ENV_FILE}."
        echo "Configure REGION in ${ENV_FILE} and run: terraform -chdir=infra apply"
        return 1
    fi

    if [[ -z "${STAGING_BUCKET:-}" ]] || [[ "${STAGING_BUCKET}" == *"your-"* ]]; then
        echo "STAGING_BUCKET is unset or contains placeholder value in ${ENV_FILE}."
        echo "Configure STAGING_BUCKET in ${ENV_FILE} and run: terraform -chdir=infra apply"
        return 1
    fi

    local hello_script="${REPO_ROOT}/bin/dataproc_hello_world.py"
    if [[ ! -f "${hello_script}" ]]; then
        echo "Dataproc hello-world script not found at: ${hello_script}"
        return 1
    fi

    local subnet_target="${SUBNET:-demo-dataproc-subnet}"
    local batch_id="${PREFLIGHT_BATCH_ID:-preflight-hello-$$}"
    local temp_table="${PREFLIGHT_HELLO_TABLE:-_preflight_hello_$$}"

    cleanup_hello_world() {
        bq rm -f -t --project_id="${PROJECT_ID}" --location="${REGION}" "${PROJECT_ID}:ops.${temp_table}" >/dev/null 2>&1 || true
        gcloud dataproc batches delete "${batch_id}" --project="${PROJECT_ID}" --region="${REGION}" --quiet >/dev/null 2>&1 || true
    }

    local submit_out
    if ! submit_out=$(gcloud dataproc batches submit pyspark "${hello_script}" \
        --project="${PROJECT_ID}" \
        --region="${REGION}" \
        --batch="${batch_id}" \
        --version="3.0" \
        --deps-bucket="gs://${STAGING_BUCKET}" \
        --subnet="${subnet_target}" \
        -- \
        --project-id "${PROJECT_ID}" \
        --dataset "ops" \
        --table "${temp_table}" \
        --staging-bucket "${STAGING_BUCKET}" 2>&1); then
        echo "Dataproc Serverless runtime 3.0 hello-world batch failed to execute."
        echo "Verify that Terraform has been applied ('terraform -chdir=infra apply'), Private Google Access is enabled on '${subnet_target}', and Shielded VM org policy constraints are satisfied."
        echo "Error details: ${submit_out}"
        cleanup_hello_world
        return 1
    fi

    local bq_out
    if ! bq_out=$(bq show --project_id="${PROJECT_ID}" --location="${REGION}" "${PROJECT_ID}:ops.${temp_table}" 2>&1); then
        echo "Dataproc hello-world batch completed, but verification table '${PROJECT_ID}:ops.${temp_table}' was not found in BigQuery."
        echo "Error details: ${bq_out}"
        cleanup_hello_world
        return 1
    fi

    cleanup_hello_world
    return 0
}

# ------------------------------------------------------------------------------
# Check 6: BigQuery MCP Authenticates as Presenter (No Compute Metadata Fallback)
# ------------------------------------------------------------------------------
check_bigquery_mcp_presenter_auth() {
    local plugin_dir="${REPO_ROOT}/.agents/plugins/dak-bigquery"
    local plugin_json="${plugin_dir}/plugin.json"
    local mcp_config="${plugin_dir}/mcp_config.json"
    local wrapper_bin="${plugin_dir}/bin/run-bigquery-mcp"
    local vendored_proxy="${plugin_dir}/mcp/bin/mcp_proxy_bundle.cjs"

    for required_file in "${plugin_json}" "${mcp_config}" "${wrapper_bin}" "${vendored_proxy}"; do
        if [[ ! -f "${required_file}" ]]; then
            echo "Required dak-bigquery plugin file missing: ${required_file}"
            return 1
        fi
    done

    if [[ ! -x "${wrapper_bin}" ]]; then
        echo "BigQuery MCP wrapper is not executable: ${wrapper_bin}"
        return 1
    fi

    if [[ -z "${PROJECT_ID:-}" ]] || [[ "${PROJECT_ID}" == *"your-"* ]]; then
        echo "PROJECT_ID is unset or contains placeholder value in ${ENV_FILE}."
        return 1
    fi

    local wrapper_env
    if ! wrapper_env=$(DEMO_ENV_FILE="${ENV_FILE}" "${wrapper_bin}" --print-env 2>&1); then
        echo "BigQuery MCP wrapper failed to load ${ENV_FILE}: ${wrapper_env}"
        return 1
    fi

    if [[ "${wrapper_env}" != *"BILLING_QUOTA_PROJECT_ID=${PROJECT_ID}"* ]]; then
        echo "BigQuery MCP wrapper did not set BILLING_QUOTA_PROJECT_ID=${PROJECT_ID}."
        return 1
    fi

    # Verify active gcloud identity is a presenter user account, not a compute service account
    if ! command -v gcloud >/dev/null 2>&1; then
        echo "gcloud CLI is not installed or not in PATH."
        return 1
    fi

    local active_account
    active_account=$(env -u CLOUDSDK_CORE_ACCOUNT -u CLOUDSDK_CORE_PROJECT gcloud config configurations list --filter="is_active=true" --format="value(properties.core.account)" 2>/dev/null || true)
    if [[ -z "${active_account}" ]]; then
        echo "No active gcloud account configured."
        echo "BigQuery MCP must authenticate as the presenter. Run: gcloud auth login"
        return 1
    fi
    if [[ "${active_account}" == *".gserviceaccount.com" ]]; then
        echo "Active gcloud account ('${active_account}') is a service account rather than the presenter's user identity."
        echo "BigQuery MCP must authenticate as the presenter. Run: gcloud auth login"
        return 1
    fi

    # Inspect ADC JSON to ensure user OAuth credentials are present so mcp_proxy_bundle.cjs
    # cannot silently fall back to http://metadata.google.internal/... service account token
    local adc_file="${GOOGLE_APPLICATION_CREDENTIALS:-${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}/application_default_credentials.json}"
    if [[ ! -f "${adc_file}" ]]; then
        echo "ADC file not found at ${adc_file}. Without user ADC, BigQuery MCP silently falls back to the compute metadata service account."
        echo "Run: gcloud auth application-default login"
        return 1
    fi

    local adc_check
    if ! adc_check=$(python3 -c "
import json, sys
with open('${adc_file}') as f:
    data = json.load(f)
cred_type = data.get('type', '')
if cred_type == 'service_account':
    print('ADC file has type=service_account; BigQuery MCP requires presenter user credentials (authorized_user).')
    sys.exit(1)
missing = [k for k in ('client_id', 'client_secret', 'refresh_token') if not isinstance(data.get(k), str) or not data.get(k).strip()]
if missing:
    print('ADC credentials file is missing user OAuth fields (' + ', '.join(missing) + ').')
    sys.exit(1)
" 2>&1); then
        echo "${adc_check}"
        echo "When user ADC fails validation, mcp_proxy_bundle.cjs silently falls back to the compute metadata service account identity."
        echo "Run: gcloud auth application-default login"
        return 1
    fi

    if ! gcloud auth application-default print-access-token >/dev/null 2>&1; then
        echo "ADC refresh token is expired or revoked and cannot mint an access token."
        echo "When user ADC token refresh fails, mcp_proxy_bundle.cjs silently falls back to the compute metadata service account identity."
        echo "Run: gcloud auth application-default login"
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 7: ds-command-center Plugin Rules & Dataset Boundary Guardrail Hook
# ------------------------------------------------------------------------------
check_ds_command_center_guardrails() {
    local plugin_dir="${REPO_ROOT}/.agents/plugins/ds-command-center"
    local plugin_json="${plugin_dir}/plugin.json"
    local hooks_json="${plugin_dir}/hooks.json"
    local rules_md="${plugin_dir}/rules/AGENTS.md"
    local guardrail_bin="${plugin_dir}/bin/guardrail-hook"

    for required_file in "${plugin_json}" "${hooks_json}" "${rules_md}" "${guardrail_bin}"; do
        if [[ ! -f "${required_file}" ]]; then
            echo "Required ds-command-center plugin file missing: ${required_file}"
            return 1
        fi
    done

    if [[ ! -x "${guardrail_bin}" ]]; then
        echo "ds-command-center guardrail hook is not executable: ${guardrail_bin}"
        echo "Run: chmod +x ${guardrail_bin}"
        return 1
    fi

    local probe_out
    if ! probe_out=$(python3 -c "
import json, subprocess, sys

hook_bin = '${guardrail_bin}'

probes = [
    (
        'bq DML/DDL targeting raw',
        {'toolCall': {'name': 'run_command', 'args': {'CommandLine': 'bq query --use_legacy_sql=false \"DROP TABLE raw.hospital_flu_feeds\"'}}},
        'deny',
        'read-only',
    ),
    (
        'BigQuery MCP execute_sql DML targeting ops',
        {'toolCall': {'name': 'execute_sql', 'args': {'sql': 'DELETE FROM ops.pipeline_run_log WHERE true'}}},
        'deny',
        'read-only',
    ),
    (
        'BigQuery MCP execute_sql read targeting checkpoint',
        {'toolCall': {'name': 'execute_sql', 'args': {'sql': 'SELECT * FROM checkpoint.clean_feeds'}}},
        'deny',
        'read-only',
    ),
    (
        'Shell bq read targeting checkpoint',
        {'toolCall': {'name': 'run_command', 'args': {'CommandLine': 'bq query --use_legacy_sql=false \"SELECT * FROM checkpoint.clean_feeds\"'}}},
        'deny',
        'read-only',
    ),
    (
        'BigQuery MCP execute_sql read targeting raw',
        {'toolCall': {'name': 'execute_sql', 'args': {'sql': 'SELECT COUNT(*) FROM raw.hospital_flu_feeds'}}},
        'allow',
        None,
    ),
    (
        'Shell bq read targeting ops',
        {'toolCall': {'name': 'run_command', 'args': {'CommandLine': 'bq query --use_legacy_sql=false \"SELECT * FROM ops.pipeline_run_log LIMIT 5\"'}}},
        'allow',
        None,
    ),
]

for label, payload, expected_decision, expected_substr in probes:
    proc = subprocess.run(
        [hook_bin],
        input=json.dumps(payload),
        text=True,
        capture_output=True,
        check=False,
    )
    if proc.returncode != 0:
        print(f'Guardrail hook exited with code {proc.returncode} on probe: {label}')
        sys.exit(1)
    try:
        resp = json.loads(proc.stdout.strip())
    except Exception as exc:
        print(f'Guardrail hook returned invalid JSON on probe ({label}): {proc.stdout!r} ({exc})')
        sys.exit(1)
    actual_decision = resp.get('decision')
    if actual_decision != expected_decision:
        print(f'Guardrail hook probe failed ({label}): expected decision={expected_decision!r}, got {actual_decision!r}')
        sys.exit(1)
    if expected_substr:
        reason = resp.get('reason', '')
        if expected_substr not in reason.lower():
            print(f'Guardrail hook probe ({label}) missing {expected_substr!r} in reason: {reason!r}')
            sys.exit(1)
" 2>&1); then
        echo "${probe_out}"
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Check 8 (Warning): Vendored BigQuery MCP Proxy Drift Check
# ------------------------------------------------------------------------------
check_vendored_proxy_drift() {
    local vendored_proxy="${REPO_ROOT}/.agents/plugins/dak-bigquery/mcp/bin/mcp_proxy_bundle.cjs"
    if [[ ! -f "${vendored_proxy}" ]]; then
        echo "Vendored BigQuery MCP proxy missing at: ${vendored_proxy}"
        return 1
    fi

    local default_dak_dir="${HOME}/.gemini/config/plugins/data-agent-kit-plugin"
    local dak_dir="${DAK_PLUGIN_DIR:-${default_dak_dir}}"
    local installed_proxy="${dak_dir}/mcp/bin/mcp_proxy_bundle.cjs"

    if [[ ! -f "${installed_proxy}" ]]; then
        echo "Installed Data Agent Kit proxy not found at: ${installed_proxy} (skipping SHA-256 comparison; using vendored copy)."
        return 1
    fi

    local drift_msg
    if ! drift_msg=$(python3 -c "
import hashlib, sys
from pathlib import Path
v_path = Path('${vendored_proxy}')
i_path = Path('${installed_proxy}')
v_hash = hashlib.sha256(v_path.read_bytes()).hexdigest()
i_hash = hashlib.sha256(i_path.read_bytes()).hexdigest()
if v_hash != i_hash:
    print(f'Vendored proxy SHA-256 ({v_hash[:12]}...) differs from installed Data Agent Kit proxy ({i_hash[:12]}...).')
    print(f'To sync with your installed Data Agent Kit, run:')
    print(f'  cp \"{i_path}\" \"{v_path}\"')
    sys.exit(1)
" 2>&1); then
        echo "${drift_msg}"
        return 1
    fi

    return 0
}

# ------------------------------------------------------------------------------
# Main Preflight Runner
# ------------------------------------------------------------------------------
main() {
    echo "=================================================="
    echo "       Command Center Preflight Verification      "
    echo "=================================================="
    echo "Environment file: ${ENV_FILE}"
    echo ""

    # Check 1: File exists
    run_check "Environment file exists" check_env_file_exists

    # Sourcing environment file if present
    if [[ -f "${ENV_FILE}" ]]; then
        # shellcheck disable=SC1090
        source "${ENV_FILE}"
    fi

    # Check 2: Environment variables and exported overrides
    run_check "Environment variables and overrides configured" check_env_variables

    # Check 3: Active gcloud project and region pinning
    run_check "Active gcloud project and region match environment" check_active_gcloud_project

    # Check 4: ADC quota project pinning and validity
    run_check "ADC quota project matches PROJECT_ID and is active" check_adc_quota_project

    # Check 5: Dataproc Serverless runtime 3.0 hello-world batch writing to BigQuery
    run_check "Dataproc Serverless runtime 3.0 hello-world batch writes to BigQuery" check_dataproc_hello_world_batch

    # Check 6: BigQuery MCP authenticates as presenter (no compute metadata fallback)
    run_check "BigQuery MCP authenticates as presenter (no compute metadata fallback)" check_bigquery_mcp_presenter_auth

    # Check 7: ds-command-center plugin rules and guardrail hook enforce dataset boundaries
    run_check "ds-command-center plugin rules and guardrail hook enforce dataset boundaries" check_ds_command_center_guardrails

    # Check 8 (Warning): Vendored BigQuery MCP proxy matches installed Data Agent Kit
    run_warn_check "Vendored BigQuery MCP proxy matches installed Data Agent Kit" check_vendored_proxy_drift

    echo ""
    echo "--------------------------------------------------"
    if [[ ${CHECKS_WARNED} -gt 0 ]]; then
        echo "Summary: ${CHECKS_PASSED} passed, ${CHECKS_FAILED} failed, ${CHECKS_WARNED} warning(s)."
    else
        echo "Summary: ${CHECKS_PASSED} passed, ${CHECKS_FAILED} failed."
    fi
    echo "--------------------------------------------------"

    if [[ ${CHECKS_FAILED} -gt 0 ]]; then
        exit 1
    fi
    exit 0
}

main "$@"
