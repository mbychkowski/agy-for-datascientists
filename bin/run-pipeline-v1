#!/usr/bin/env bash
# ==============================================================================
# Run Workstream 1 Pipeline v1 on Dataproc Serverless
#
# Submits pipelines/pipeline_v1.py to Dataproc Serverless runtime 3.0 as the
# presenter to materialise the defective staging table staging.hospital_flu
# (with duplicate Hospital Feeds intact) and labels it demo:true.
# ==============================================================================

set -uo pipefail

# Resolve real script directory through any symlinks (CODING_STANDARDS.md §1)
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "${SOURCE}" ]]; do
    DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
# shellcheck source=lib/pinning.sh
source "${SCRIPT_DIR}/lib/pinning.sh"

ENV_FILE="${REPO_ROOT}/demo.env"

usage() {
    echo "Usage: bin/run-pipeline-v1 [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -e, --env <path>  Path to environment file (default: demo.env)"
    echo "  -h, --help        Show this help message"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --env|-e)
            ENV_FILE="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

if ! pinned_load_env "${ENV_FILE}"; then
    exit 1
fi

# Fail fast: the sync path labels via bq only after a multi-minute Dataproc batch.
if ! pinned_require_cli gcloud bq; then
    exit 1
fi

PIPELINE_SCRIPT="${REPO_ROOT}/pipelines/pipeline_v1.py"
if [[ ! -f "${PIPELINE_SCRIPT}" ]]; then
    echo "[FAIL] Pipeline v1 script not found: ${PIPELINE_SCRIPT}" >&2
    exit 1
fi

BATCH_ID="${PIPELINE_V1_BATCH_ID:-ws1-pipeline-v1-$(date +%s)-$$}"

echo "Submitting Workstream 1 Pipeline v1 to Dataproc Serverless (batch: ${BATCH_ID})..."
if ! pinned_dataproc_submit "${PIPELINE_SCRIPT}" "${BATCH_ID}" \
    -- \
    --project-id "${PROJECT_ID}" \
    --raw-dataset "raw" \
    --staging-dataset "staging" \
    --output-table "hospital_flu" \
    --staging-bucket "${STAGING_BUCKET}"; then
    echo "[FAIL] Pipeline v1 Dataproc Serverless batch failed." >&2
    exit 1
fi

echo "Applying label demo:true to ${PROJECT_ID}:staging.hospital_flu..."
if ! pinned_label "staging.hospital_flu"; then
    exit 1
fi

echo "[PASS] Pipeline v1 materialised ${PROJECT_ID}:staging.hospital_flu (with duplicates intact) and applied label demo:true."
exit 0
