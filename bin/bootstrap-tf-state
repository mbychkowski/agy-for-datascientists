#!/usr/bin/env bash
# ==============================================================================
# Bootstrap Dedicated Terraform State Bucket & Initialize Backend
#
# Creates gs://${STATE_BUCKET} in ${PROJECT_ID} (${REGION}) if it does not
# already exist, enables object versioning and the demo:true label, and runs
# `terraform -chdir=infra init -backend-config="bucket=${STATE_BUCKET}"`.
# ==============================================================================

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "${SOURCE}" ]]; do
    DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
# shellcheck source=lib/pinning.sh
source "${SCRIPT_DIR}/lib/pinning.sh"

ENV_FILE="${REPO_ROOT}/demo.env"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --env|-e)
            ENV_FILE="$2"
            shift 2
            ;;
        --help|-h)
            echo "Usage: ./bin/bootstrap-tf-state [--env <path>]"
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

# Pinning functions return non-zero rather than exiting, so every call is
# guarded explicitly; set -e stays on as a backstop for terraform and the shell.
if ! pinned_load_env "${ENV_FILE}" || ! pinned_require_state_bucket; then
    echo "Copy demo.env.example to demo.env and set PROJECT_ID, REGION, STAGING_BUCKET, and STATE_BUCKET." >&2
    exit 1
fi

if ! pinned_require_cli gcloud terraform; then
    exit 1
fi

echo "Checking dedicated Terraform state bucket gs://${STATE_BUCKET} in project ${PROJECT_ID} (${REGION})..."
if ! pinned_storage buckets describe "gs://${STATE_BUCKET}" >/dev/null 2>&1; then
    echo "Creating dedicated state bucket gs://${STATE_BUCKET}..."
    if ! pinned_storage buckets create "gs://${STATE_BUCKET}" \
        --location="${REGION}" \
        --uniform-bucket-level-access \
        --public-access-prevention; then
        echo "[FAIL] Failed to create state bucket gs://${STATE_BUCKET}" >&2
        exit 1
    fi
fi

echo "Applying versioning and demo:true label to gs://${STATE_BUCKET}..."
if ! pinned_storage buckets update "gs://${STATE_BUCKET}" \
    --versioning \
    --update-labels="demo=true" >/dev/null; then
    echo "[FAIL] Failed to apply versioning and demo:true label to gs://${STATE_BUCKET}" >&2
    exit 1
fi

echo "Initializing Terraform backend in ${REPO_ROOT}/infra..."
terraform -chdir="${REPO_ROOT}/infra" init -reconfigure -backend-config="bucket=${STATE_BUCKET}"
echo "Terraform state backend ready in gs://${STATE_BUCKET}."
