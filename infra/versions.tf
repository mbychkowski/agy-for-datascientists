terraform {
  required_version = ">= 1.5.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 5.0.0"
    }
  }

  # Dedicated GCS state bucket (configured via -backend-config="bucket=${STATE_BUCKET}")
  backend "gcs" {
    prefix = "agy-for-datascientists/state"
  }
}

provider "google" {
  project               = var.project_id
  region                = var.region
  user_project_override = true
  billing_project       = var.project_id
}
