# Private brief: contains client-identifying details. Delete before first push.
PROBLEM.md

# Agent workspace for parallel issue triaging
.worktree

# Per-user environment (copy from demo.env.example)
demo.env

# Agent config under .agents/: the demo's plugins plus the shared skills,
# rules, and workflows used to build this repo are tracked; anything else
# (e.g. per-user mcp_config.json) stays local.
.agents/*
!.agents/plugins/
!.agents/plugins.json
!.agents/skills.json
!.agents/rules/
!.agents/skills/
!.agents/workflows/
skills-lock.json
.vscode/

# Data Agent Kit workspace skill install (Google Cloud Software License; install via DAK)
# Installed per workspace by the DAK extension, under the Google Cloud Software License, so must not be published.
.gemini/skills/

# Node
node_modules/

# Evidence Board frontend build output (make build-frontend)
.agents/plugins/ds-command-center/sidecars/evidence-board/frontend/dist/
*.tsbuildinfo

# Evidence Board event log, appended by the ds-command-center event recorder hook
.evidence-board/

# Terraform local state and caches
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Python
__pycache__/
.venv/
.ruff_cache/
.ipynb_checkpoints/

# OS artifacts
.DS_Store
Thumbs.db

# Knowledge graph output (local cache)
graphify-out/


